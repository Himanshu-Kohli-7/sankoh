---
/**
 * Request a quote — interim page. The Preact form (SPEC §6.1) replaces it at the same URL next round.
 * Until then: phone, WhatsApp (generic message: this static page does not read ?product=) and email,
 * with what to include for each enquiry type. Canonical is the bare URL (SEO.astro uses the pathname).
 */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { site, telHref, waHref } from '../config/site';
import { pageTitle } from '../lib/content';

const whatsappText = `Hello ${site.name}, I would like a quote.`;
const mailHref = `mailto:${site.email}?subject=${encodeURIComponent('Enquiry')}`;

const types = [
  {
    icon: 'valve',
    title: 'Product',
    lead: 'A valve, automation part or instrument.',
    items: ['Product type or name', 'Size or measuring range', 'Media, pressure and temperature', 'Material and connection', 'Quantity', 'Delivery location'],
  },
  {
    icon: 'wrench',
    title: 'Repair',
    lead: 'A valve, actuator, positioner or VFD of any make.',
    items: ['Photo of the unit and its nameplate or label', 'Make and model', 'What is wrong with it', 'On site or at our workshop', 'Number of units', 'Your location'],
  },
  {
    icon: 'box',
    title: 'Sourcing',
    lead: 'Something we don’t list, or a discontinued part.',
    items: ['Make, model or part number', 'Datasheet or nameplate photo', 'Size and connections', 'Media, pressure and temperature', 'Quantity', 'Delivery location'],
  },
  {
    icon: 'search',
    title: 'Advice',
    lead: 'Help choosing a valve, or a technical question.',
    items: ['What the valve or instrument must do', 'Media, pressure and temperature', 'Line size', 'What is installed now', 'Problems seen so far', 'Photos, if you have them'],
  },
];

const breadcrumbs = [{ label: 'Request a quote' }];
---

<Base
  title={pageTitle('Request a Quote')}
  description={`Request a quote from ${site.name}: call or WhatsApp ${site.phone.display}, or email your requirement for products, repair, sourcing or advice.`}
  pageName="Request a quote"
  {whatsappText}
  {breadcrumbs}
>
  <PageHero
    {breadcrumbs}
    division="repair"
    eyebrow="Enquiry"
    title="Request a quote"
    lead="Send us your requirement by WhatsApp, email or phone. Our engineers will come back with a quote or the questions we need answered first."
  />

  <section class="container-content section-y">
    <ul class="ways">
      <li>
        <Icon name="whatsapp" size={28} />
        <h2>WhatsApp</h2>
        <p>Best for photos of a nameplate, a drawing or a faulty unit.</p>
        <Button href={waHref(whatsappText)} icon="whatsapp" data-event="click_whatsapp">{site.whatsapp.display}</Button>
      </li>
      <li>
        <Icon name="mail" size={28} />
        <h2>Email</h2>
        <p>Best for datasheets, lists and larger requirements.</p>
        <Button href={mailHref} variant="secondary" icon="mail">{site.email}</Button>
      </li>
      <li>
        <Icon name="phone" size={28} />
        <h2>Phone</h2>
        <p>{site.hours.display}. {site.service.supportLine}.</p>
        <Button href={telHref()} variant="secondary" icon="phone" data-event="click_call">{site.phone.display}</Button>
      </li>
    </ul>
  </section>

  <section class="band">
    <div class="container-content section-y">
      <SectionHeader eyebrow="Checklist" division="repair" title="What to include" intro="Pick the kind of enquiry. The details listed help us quote in one go." />
      <ul class="types">
        {types.map((t) => (
          <li>
            <div class="type-head">
              <Icon name={t.icon} size={24} />
              <h3>{t.title}</h3>
            </div>
            <p class="type-lead">{t.lead}</p>
            <ul class="items">
              {t.items.map((item) => <li><Icon name="check" size={18} />{item}</li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<style>
  .ways { display: grid; gap: 0.75rem; }
  .ways > li { display: grid; align-content: start; gap: 0.75rem; padding: 1.5rem; border: 1px solid var(--color-line); border-top: 4px solid var(--color-amber); border-radius: 2px; }
  .ways > li > :global(svg) { color: var(--color-blue); }
  .ways h2 { font-size: var(--text-h3); }
  .ways p { color: var(--color-slate); font-size: 0.9375rem; line-height: 1.5; }
  .ways :global(.btn) { justify-self: start; max-width: 100%; overflow-wrap: anywhere; }

  .band { background: var(--color-paper); border-top: 1px solid var(--color-line); }
  .types { display: grid; gap: 0.75rem; margin-top: 2rem; }
  .types > li { padding: 1.5rem; background: var(--color-white); border: 1px solid var(--color-line); border-radius: 2px; }
  .type-head { display: flex; align-items: center; gap: 0.625rem; }
  .type-head :global(svg) { color: var(--color-blue); }
  .type-head h3 { font-size: 1.25rem; }
  .type-lead { margin-top: 0.5rem; color: var(--color-slate); font-size: 0.9375rem; }
  .items { display: grid; gap: 0.5rem; margin-top: 1rem; }
  .items li { display: flex; gap: 0.5rem; font-size: 0.9375rem; line-height: 1.4; }
  .items :global(svg) { flex: none; margin-top: 0.0625rem; color: var(--color-blue); }

  @media (min-width: 768px) {
    .ways { grid-template-columns: repeat(3, 1fr); }
    .types { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1100px) {
    .types { grid-template-columns: repeat(4, 1fr); }
  }
</style>
