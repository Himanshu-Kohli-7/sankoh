---
/** 404 (SPEC §2.1): noindex, out of the sitemap, with the main routes and call / WhatsApp. */
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import { site, telHref, waHref } from '../config/site';

const links = [
  { label: 'Products', href: '/products/', icon: 'valve' },
  { label: 'Valve repair', href: '/valve-repair/', icon: 'wrench' },
  { label: 'VFD repair', href: '/vfd-repair/', icon: 'drive' },
  { label: 'Services', href: '/services/', icon: 'search' },
  { label: 'Contact', href: '/contact/', icon: 'phone' },
];
---

<Base
  title={`Page not found | ${site.name}`}
  description="The page you were looking for is not here. Find industrial valves, instruments, valve and VFD repair and services from Sankoh Technical Solutions."
  pageName="Page not found"
  noindex
>
  <PageHero breadcrumbs={[{ label: 'Page not found' }]} division="valves" eyebrow="Error 404" title="Page not found" lead="The page you asked for is not here. It may have moved when our site was rebuilt. Try one of these, or call us.">
    <div class="actions">
      <Button href={telHref()} icon="phone" data-event="click_call">Call {site.phone.display}</Button>
      <Button href={waHref(`Hello ${site.name}, I could not find a page on your website.`)} variant="secondary" icon="whatsapp" data-event="click_whatsapp">WhatsApp</Button>
    </div>
  </PageHero>

  <section class="container-content section-y">
    <ul class="links">
      {links.map((l) => (
        <li><a href={l.href}><Icon name={l.icon} size={24} />{l.label}<Icon name="arrow-right" size={20} /></a></li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .links { display: grid; gap: 0.75rem; }
  .links a { display: flex; align-items: center; gap: 0.75rem; min-height: 3.5rem; padding: 0.75rem 1.25rem; border: 1px solid var(--color-line); border-left: 4px solid var(--color-navy); border-radius: 2px; color: var(--color-navy); font-weight: 600; text-decoration: none; }
  .links a :global(svg:first-child) { color: var(--color-blue); }
  .links a :global(svg:last-child) { margin-left: auto; }
  .links a:hover { border-color: #b9c6d3; color: var(--color-blue); }
  @media (min-width: 768px) {
    .links { grid-template-columns: repeat(3, 1fr); }
  }
</style>
