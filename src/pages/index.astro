---
/* Homepage: the eleven sections of SPEC §3, in order. Each lives in components/home/. */
import Base from '../layouts/Base.astro';
import CTABand from '../components/CTABand.astro';
import Hero from '../components/home/Hero.astro';
import Divisions from '../components/home/Divisions.astro';
import CategoryGrid from '../components/home/CategoryGrid.astro';
import RepairBand from '../components/home/RepairBand.astro';
import SelectorTeaser from '../components/home/SelectorTeaser.astro';
import BrandsStrip from '../components/home/BrandsStrip.astro';
import WhySankoh from '../components/home/WhySankoh.astro';
import Applications from '../components/home/Applications.astro';
import Trust from '../components/home/Trust.astro';
import ContactBlock from '../components/home/ContactBlock.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import { site } from '../config/site';
---

<Base
  title={`${site.name} – Valves, Instruments & Repair, India`}
  description="Industrial valves, valve automation and process instruments, plus valve and VFD repair of any make, on site or in our workshop. Derabassi, Punjab."
>
  <Hero />
  <Divisions />
  <CategoryGrid />
  <RepairBand />
  <SelectorTeaser />
  <BrandsStrip />
  <WhySankoh />
  <Applications />
  <Trust />
  <ContactBlock />
  <HomeFaq />
  <CTABand />
</Base>
