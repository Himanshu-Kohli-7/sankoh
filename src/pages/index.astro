---
import Base from '../layouts/Base.astro';
import { site, telHref, waHref } from '../config/site';
---

<Base
  title={`${site.name} – Valves, Instruments & Repair, India`}
  description={`${site.positioning} ${site.address.locationWording}.`}
>
  <main class="container-content section-y">
    <p class="eyebrow text-blue">Phase 0 scaffold</p>
    <h1>{site.name}</h1>
    <p class="text-slate mt-4 max-w-prose">{site.positioning}</p>
    <p class="mt-4">
      {site.address.locationWording} · <a href={telHref()}>{site.primaryPhone.display}</a>{" · "}
      <a href={waHref()}>WhatsApp</a>
    </p>
  </main>
</Base>
