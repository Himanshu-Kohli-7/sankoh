---
/**
 * Product selector (SPEC §6.2). Server-rendered intro and full product list (the no-JS fallback),
 * filtered in the browser by the ProductSelector island. State in the URL hash only.
 */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SourcingBlock from '../components/SourcingBlock.astro';
import CTABand from '../components/CTABand.astro';
import ProductSelector from '../components/selector/ProductSelector';
import { pageTitle } from '../lib/content';
import { selectorData } from '../lib/selector';

const { items, filters } = await selectorData();
const breadcrumbs = [{ label: 'Products', href: '/products/' }, { label: 'Product selector' }];
---

<Base
  title={pageTitle('Product Selector')}
  description="Find the right industrial valve or instrument: filter every product by type, how it is operated, the media it handles and where it is used."
  pageName="Product selector"
  {breadcrumbs}
>
  <PageHero
    {breadcrumbs}
    division="valves"
    eyebrow="Product selector"
    title="Find the right product"
    lead={`Narrow our ${items.length} valves, automation parts and instruments by type, by how they are operated, by what flows through them and by where they are used. Every product is available to your specification; if nothing fits, we can source it.`}
  />

  <section class="container-content section-y selector">
    <p class="nojs-note">All products are listed below by type. Each one links to its page.</p>
    <ProductSelector client:load {items} {filters} sourcingHref="/services/product-sourcing/" />
  </section>

  <section class="container-content section-y">
    <SourcingBlock />
  </section>
  <CTABand title="Not sure which one you need?" />
</Base>

<style>
  .nojs-note { margin-bottom: 1.5rem; color: var(--color-slate); }
  :global(html.js) .nojs-note { display: none; }
  :global(html:not(.js)) .selector :global(.ps-filters) { display: none; }

  .selector :global(.ps-filters) { display: grid; gap: 1.25rem; padding: 1.25rem; border: 1px solid var(--color-line); border-top: 4px solid var(--color-blue); border-radius: 2px; background: var(--color-white); }
  .selector :global(.ps-filter) { display: grid; gap: 0.5rem; min-width: 0; border: 0; padding: 0; margin: 0; }
  .selector :global(.ps-filter legend) { margin-bottom: 0.5rem; padding: 0; color: var(--color-slate); }
  .selector :global(.ps-group) { display: grid; gap: 0.375rem; }
  .selector :global(.ps-group + .ps-group) { margin-top: 0.5rem; }
  .selector :global(.ps-group-label) { color: var(--color-navy); font-size: 0.875rem; font-weight: 600; }
  .selector :global(.ps-chips) { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .selector :global(.ps-chip) {
    display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 0.875rem;
    border: 1px solid #b9c6d3; border-radius: 2px; background: var(--color-white); color: var(--color-navy);
    font: inherit; font-size: 0.9375rem; font-weight: 600; cursor: pointer; transition: background-color 0.15s, color 0.15s, border-color 0.15s;
  }
  .selector :global(.ps-chip:hover:not([disabled])) { border-color: var(--color-navy); }
  .selector :global(.ps-chip[aria-pressed='true']) { background: var(--color-navy); border-color: var(--color-navy); color: var(--color-white); }
  .selector :global(.ps-chip[disabled]) { color: #8a97a6; border-style: dashed; cursor: not-allowed; }
  .selector :global(.ps-chip:focus-visible), .selector :global(.ps-clear:focus-visible) { outline: 3px solid var(--color-blue); outline-offset: 2px; }
  .selector :global(.ps-count) { font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; color: var(--color-slate); }
  .selector :global(.ps-chip[aria-pressed='true'] .ps-count) { color: rgb(255 255 255 / 0.8); }

  .selector :global(.ps-status) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem; padding-top: 1rem; border-top: 1px solid var(--color-line); }
  .selector :global(.ps-clear) { min-height: 2.75rem; padding: 0 1rem; border: 1px solid var(--color-navy); border-radius: 2px; background: transparent; color: var(--color-navy); font: inherit; font-weight: 600; cursor: pointer; }
  .selector :global(.ps-clear:hover) { background: var(--color-navy); color: var(--color-white); }

  .selector :global(.ps-empty) { display: grid; gap: 0.75rem; justify-items: start; margin-top: 2rem; padding: 1.5rem; border-left: 4px solid var(--color-amber); background: var(--color-paper); }
  .selector :global(.ps-empty a) { color: var(--color-blue); font-weight: 600; }

  .selector :global(.ps-type) { margin-top: 2.5rem; }
  .selector :global(.ps-type-title) { display: flex; align-items: baseline; gap: 0.625rem; font-size: var(--text-h3); }
  .selector :global(.ps-type-count) { font-family: var(--font-mono); font-size: 0.875rem; font-weight: 500; color: var(--color-slate); }
  .selector :global(.ps-results) { display: grid; gap: 0.75rem; margin-top: 1rem; }
  .selector :global(.ps-item) {
    --division: var(--color-navy);
    position: relative; display: grid; grid-template-columns: 5.5rem 1fr; gap: 1rem; align-items: start; padding: 1rem;
    border: 1px solid var(--color-line); border-top: 3px solid var(--division); border-radius: 2px; background: var(--color-white);
    transition: border-color 0.15s, transform 0.15s;
  }
  .selector :global(.ps-item[data-division='instruments']) { --division: var(--color-blue); }
  .selector :global(.ps-item:hover) { border-color: #b9c6d3; border-top-color: var(--division); transform: translateY(-2px); }
  .selector :global(.ps-item:has(a:focus-visible)) { outline: 3px solid var(--color-blue); outline-offset: 2px; }
  .selector :global(.ps-media) { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--color-paper); border-radius: 2px; overflow: hidden; }
  .selector :global(.ps-media img) { width: 100%; height: 100%; object-fit: contain; }
  .selector :global(.ps-media svg) { width: 80%; fill: none; stroke: var(--color-slate); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .selector :global(.ps-title) { font-size: 1.0625rem; line-height: 1.3; }
  .selector :global(.ps-title a) { color: var(--color-navy); text-decoration: none; }
  .selector :global(.ps-title a::after) { content: ''; position: absolute; inset: 0; }
  .selector :global(.ps-title a:focus-visible) { outline: none; }
  .selector :global(.ps-summary) { margin-top: 0.25rem; color: var(--color-slate); font-size: 0.9375rem; line-height: 1.45; }
  .selector :global(.ps-tags) { display: flex; flex-wrap: wrap; gap: 0.375rem; margin-top: 0.625rem; }
  .selector :global(.ps-tags span) { padding: 0.125rem 0.5rem; border: 1px solid var(--color-line); border-radius: 2px; font-family: var(--font-mono); font-size: 0.75rem; color: var(--color-slate); }

  @media (min-width: 768px) {
    .selector :global(.ps-results) { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .selector :global(.ps-filters) { grid-template-columns: 2fr 1fr; gap: 1.5rem 2.5rem; padding: 1.5rem; }
    .selector :global(.ps-filter:first-child) { grid-row: span 3; }
    .selector :global(.ps-status) { grid-column: 1 / -1; }
    .selector :global(.ps-results) { grid-template-columns: repeat(3, 1fr); }
  }
</style>
