---
/*
 * Temporary styleguide: every shared component with real content only.
 * noindex and left out of the sitemap (astro.config.mjs). Delete before launch.
 */
import Base from '../layouts/Base.astro';
import BlueprintGrid from '../components/BlueprintGrid.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Button from '../components/Button.astro';
import CategoryCard from '../components/CategoryCard.astro';
import ClientLogoStrip from '../components/ClientLogoStrip.astro';
import CTABand from '../components/CTABand.astro';
import DivisionBadge from '../components/DivisionBadge.astro';
import EnquiryChecklist from '../components/EnquiryChecklist.astro';
import FAQ from '../components/FAQ.astro';
import Icon from '../components/Icon.astro';
import PipelineDivider from '../components/PipelineDivider.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ProductCard from '../components/ProductCard.astro';
import RepairServiceCard from '../components/RepairServiceCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SourcingBlock from '../components/SourcingBlock.astro';
import TrustStats from '../components/TrustStats.astro';
import { site, telHref } from '../config/site';
import { productGroups, repairGroups } from '../config/nav';

import pneumaticBall from '../assets/products/pneumatic-actuated-ball-valve.png';
import electricBall from '../assets/products/electric-actuated-ball-valve.png';
import globeControl from '../assets/products/pneumatic-globe-control-valve.png';
import wipro from '../assets/clients/wipro.svg';
import vardhaman from '../assets/clients/vardhaman.svg';
import godrej from '../assets/clients/godrej.jpg';
import hul from '../assets/clients/hindustan-unilever.webp';
import birla from '../assets/clients/birla.webp';
import nahar from '../assets/clients/nahar.jpeg';

const crumbs = [
  { label: 'Products', href: '/products/' },
  { label: 'Pneumatic Actuated Valves', href: '/products/pneumatic-actuated-valves/' },
  { label: 'Pneumatic Actuated Ball Valve' },
];

const clients = [
  { name: 'Vardhaman', logo: vardhaman },
  { name: 'Wipro', logo: wipro },
  { name: 'Birla', logo: birla },
  { name: 'Godrej', logo: godrej },
  { name: 'HUL', logo: hul },
  { name: 'Nahar', logo: nahar },
];

const faqs = [
  { question: 'Do you repair valves from other manufacturers?', answer: `Yes. We repair ${site.service.repairScope.valves.toLowerCase()}.` },
  { question: 'How long does a repair take?', answer: `${site.service.repairTurnaround}.` },
  { question: 'Where do you deliver?', answer: `${site.service.area}.` },
];

const icons = [
  'valve', 'actuator', 'electric', 'solenoid', 'accessory', 'flow', 'pressure', 'temperature', 'level', 'analyzer',
  'drive', 'servo', 'hmi', 'wrench', 'phone', 'whatsapp', 'quote', 'mail', 'pin', 'download', 'search', 'clock',
  'calendar', 'users', 'box', 'truck', 'report', 'check', 'plus', 'arrow-right',
];
const swatches = ['navy', 'blue', 'cyan', 'amber', 'ink', 'slate', 'line', 'paper'];
const [valves, instruments] = productGroups;
---

<Base title="Styleguide | Sankoh Technical Solutions" description="Internal reference for the shared components of the Sankoh website." noindex>
  <section class="relative border-b border-line">
    <BlueprintGrid />
    <div class="container-content relative pt-4 pb-14 lg:pb-20">
      <Breadcrumbs items={crumbs} division="valves" />
      <SectionHeader
        class="mt-6"
        as="h1"
        eyebrow="Styleguide"
        title="Shared components"
        intro="Every building block used across the site, shown with confirmed company facts only."
      />
    </div>
  </section>

  <div class="container-content sg">
    <section>
      <h2 class="sg-label">Type and colour</h2>
      <div class="grid gap-10 lg:grid-cols-2">
        <div>
          <p class="text-h1 font-semibold leading-[1.15] text-navy">Heading one</p>
          <p class="mt-3 text-h2 font-semibold leading-[1.15] text-navy">Heading two</p>
          <p class="mt-3 text-h3 font-semibold text-navy">Heading three</p>
          <p class="mt-4 max-w-prose">Body text is IBM Plex Sans at 17px with a 1.6 line height. {site.positioning}</p>
          <p class="mt-2 text-small text-slate">Small text, 14px, for secondary notes.</p>
          <p class="mt-4 font-mono font-medium text-navy">{site.primaryPhone.display} · {site.gstin}</p>
        </div>
        <ul class="grid grid-cols-4 gap-3 self-start">
          {swatches.map((name) => (
            <li>
              <span class="block h-14 rounded-[2px] border border-line" style={`background: var(--color-${name})`}></span>
              <span class="eyebrow mt-2 block text-slate">{name}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section>
      <h2 class="sg-label">Buttons and division badges</h2>
      <div class="flex flex-wrap items-center gap-3">
        <Button href="/request-a-quote/">Get a quote</Button>
        <Button href={telHref()} variant="secondary" icon="phone">Call now</Button>
        <Button href="/request-a-quote/" size="sm">Get a Quote</Button>
        <span class="inline-flex flex-wrap gap-3 bg-navy p-3">
          <Button href="/request-a-quote/">Get a quote</Button>
          <Button href={telHref()} variant="on-dark" icon="phone">Call now</Button>
        </span>
      </div>
      <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
        <DivisionBadge division="valves" />
        <DivisionBadge division="instruments" />
        <DivisionBadge division="repair" />
        <DivisionBadge division="repair" label="Repair / 02" />
      </div>
    </section>

    <section>
      <h2 class="sg-label">Icons</h2>
      <ul class="grid grid-cols-5 gap-x-2 gap-y-5 text-navy sm:grid-cols-8 lg:grid-cols-10">
        {icons.map((name) => (
          <li class="grid justify-items-center gap-1.5">
            <Icon name={name} size={28} />
            <span class="text-center font-mono text-[0.6875rem] text-slate">{name}</span>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="sg-label">Section header and category cards</h2>
      <SectionHeader
        eyebrow={instruments.label}
        division="instruments"
        title="Process instruments"
        intro="Flow, pressure, temperature, level and analytical instruments."
      />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <CategoryCard division="valves" title={valves.links[0].label} href={valves.links[0].href} icon="valve" description="Hand-operated valves for isolating, regulating and protecting a line." />
        <CategoryCard division="valves" title={valves.links[1].label} href={valves.links[1].href} icon="actuator" description="Valves opened and closed by compressed air." />
        <CategoryCard division="instruments" title={instruments.links[0].label} href={instruments.links[0].href} icon="flow" description="Meters that measure how much liquid or gas passes through a pipe." />
        <CategoryCard division="instruments" title={instruments.links[3].label} href={instruments.links[3].href} icon="level" description="Transmitters and switches for tank and silo level." count={7} />
      </div>
    </section>

    <section>
      <h2 class="sg-label">Product cards</h2>
      <div class="grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
        <ProductCard title="Pneumatic Actuated Ball Valve" href="/products/pneumatic-actuated-valves/pneumatic-actuated-ball-valve/" image={pneumaticBall} imageAlt="Pneumatic actuated ball valve with flanged ends and a limit switch box" summary="A ball valve turned by a pneumatic actuator for on/off control." />
        <ProductCard title="Electric Actuated Ball Valve" href="/products/electric-actuated-valves/electric-actuated-ball-valve/" image={electricBall} imageAlt="Ball valve fitted with an electric actuator" summary="A ball valve turned by an electric motor actuator." />
        <ProductCard title="Pneumatic Globe Control Valve" href="/products/pneumatic-actuated-valves/pneumatic-globe-control-valve/" image={globeControl} imageAlt="Pneumatic globe control valve with diaphragm actuator and positioner" summary="A globe valve that regulates flow from a control signal." />
        <ProductCard division="instruments" title="Thermowell" href="/products/temperature-instruments/thermowell/" summary="Shown without a photo: the placeholder drawing." />
      </div>
    </section>

    <section>
      <h2 class="sg-label">Repair: fact strip, service cards, process</h2>
      <TrustStats />
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {repairGroups[0].links.slice(0, 3).map((link) => (
          <RepairServiceCard title={link.label} href={link.href} icon={link.icon ?? 'wrench'} />
        ))}
        {repairGroups[1].links.map((link) => (
          <RepairServiceCard title={link.label} href={link.href} icon={link.icon ?? 'wrench'} />
        ))}
      </div>
      <div class="mt-12">
        <ProcessSteps />
      </div>
    </section>

    <section>
      <h2 class="sg-label">Pipeline divider</h2>
      <PipelineDivider />
    </section>

    <section>
      <h2 class="sg-label">Enquiry checklist and sourcing block</h2>
      <div class="grid gap-4 lg:grid-cols-2">
        <EnquiryChecklist kind="valve" headingLevel="h3" />
        <EnquiryChecklist kind="instrument" headingLevel="h3" />
      </div>
      <div class="mt-8">
        <SourcingBlock headingLevel="h3" />
      </div>
    </section>

    <section>
      <h2 class="sg-label">Trust: client logos and reviews</h2>
      <ClientLogoStrip clients={clients} />
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        <ReviewCard
          quote="We rely on Sankoh for automated valves and process instruments. Their products and support are always top-notch."
          name="Mr. Ajay Tyagi"
          role="Instrument Head"
          company="Wipro Enterprises"
          logo={wipro}
        />
        <ReviewCard
          quote="Sankoh provides excellent manual valves with great durability. Their products always meet our high standards."
          name="Mr. Ravindra Kumar"
          role="Mechanical Head"
          company="Hindustan Unilever Limited"
          logo={hul}
        />
      </div>
    </section>

    <section>
      <h2 class="sg-label">FAQ</h2>
      <FAQ items={faqs} />
    </section>
  </div>

  <section class="relative bg-navy">
    <BlueprintGrid tone="dark" fade="none" />
    <div class="container-content relative py-16">
      <SectionHeader tone="on-dark" division="repair" eyebrow="Repair & Service" title="Any make. Any model." intro="The fact strip and section header on a navy section." />
      <div class="mt-8"><TrustStats tone="dark" /></div>
    </div>
  </section>

  <CTABand />
</Base>

<style>
  .sg > section { padding-block: 3rem; border-bottom: 1px solid var(--color-line); }
  .sg > section:last-child { border-bottom: 0; }
  .sg-label { margin-bottom: 1.5rem; color: var(--color-slate); font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
</style>
