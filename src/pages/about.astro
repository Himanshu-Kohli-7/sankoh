---
/**
 * About (SPEC §5.5): positioning, the proprietor and company facts, what we make (Sankoh® manual valves,
 * with the type links) vs what we supply (the partner logos), site jobs (away from the client logos), why Sankoh,
 * trust (clients, reviews),
 * where we work, location. Facts from site.ts only (CLAUDE.md §4): founding, clients, team and Udyam
 * as confirmed on 21 Nov 2026; no certifications or awards. Certifications and projects appear only
 * once their content folders have entries (CLAUDE.md §8).
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BlueprintGrid from '../components/BlueprintGrid.astro';
import Button from '../components/Button.astro';
import CTABand from '../components/CTABand.astro';
import Icon from '../components/Icon.astro';
import PartnerLogo from '../components/PartnerLogo.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Trust from '../components/home/Trust.astro';
import WhereWeWork from '../components/WhereWeWork.astro';
import SiteJobs from '../components/SiteJobs.astro';
import WhySankoh from '../components/home/WhySankoh.astro';
import ownerPhoto from '../assets/about/sanjay-kohli.jpg';
import { site, listAnd, mapsHref } from '../config/site';
import { isPublished, pageTitle, productHref, productSlug, productsIn } from '../lib/content';

const { proprietor } = site.people;
const own = site.brands.own[0];
const partners = listAnd(site.brands.authorisedPartners);
const { company } = site;
/** Partner name → the range we trade from it (site.brands.partnerLines). */
const traded = site.brands.authorisedPartners.map((name) => {
  const key = name.split(' ')[0].toLowerCase();
  return { name, key, line: site.brands.partnerLines[key] };
});
/** Manual valve types we make, linked to their pages (published ones only), in this order. */
const madeTypes: [slug: string, label: string][] = [
  ['ball-valve-flanged-end', 'Ball'], ['gate-valve', 'Gate'], ['globe-valve', 'Globe'], ['butterfly-valve', 'Butterfly'],
  ['dual-plate-check-valve', 'Check'], ['plug-valve', 'Plug'], ['needle-valve', 'Needle'], ['knife-gate-valve', 'Knife gate'],
  ['safety-valve', 'Safety'], ['strainer', 'Strainer'],
];
const manualValves = (await productsIn('manual-valves')).filter(isPublished);
const madeLinks = madeTypes.flatMap(([slug, label]) => {
  const p = manualValves.find((m) => productSlug(m) === slug);
  return p ? [{ label, href: productHref(p) }] : [];
});
const facts = [
  { key: 'Founded', value: company.foundingDisplay },
  { key: 'Clients', value: company.clientCount },
  { key: 'Team', value: `${company.teamSize} people` },
  { key: 'Engineers', value: `${company.engineerExperience}' experience` },
  { key: 'Valves supplied', value: `${company.valvesSuppliedPerYear} a year` },
  { key: 'Repairs', value: `${site.service.repairsPerYear} valves a year` },
  { key: 'Udyam', value: company.udyam.number || 'Registered' },
];
const breadcrumbs = [{ label: 'About' }];
---

<Base
  title={pageTitle('About Us')}
  description={`${site.name}, Derabassi, Punjab, since ${company.foundingYear}: ${own} manual valves, partner for automated valves and instruments, valve and VFD repair.`}
  pageName="About"
  {breadcrumbs}
>
  <PageHero
    {breadcrumbs}
    division="valves"
    eyebrow="Company"
    title={`About ${site.name}`}
    lead={`${site.name} manufactures ${site.brands.manufactured} under its own brand ${own}, supplies automated valves and process instruments as an authorised partner of ${partners}, and repairs valves, actuators, positioners and VFDs of any make, on site or in its workshop.`}
  />

  <section class="container-content section-y owner-section">
    <figure class="owner">
      <div class="backplate" aria-hidden="true"><BlueprintGrid fade="none" /></div>
      <div class="frame">
        <Image
          src={ownerPhoto}
          alt={`${proprietor.name}, ${proprietor.title} of ${site.name}, in the office`}
          widths={[320, 480, 640, 704]}
          quality={75}
          sizes="(min-width: 1024px) 352px, (min-width: 640px) 40vw, 92vw"
          width={704}
          loading="lazy"
        />
      </div>
      <figcaption class="plate">
        <span class="plate-co">{site.name}</span>
        <span class="plate-row"><span class="plate-key">Name</span><span class="name">{proprietor.name}</span></span>
        <span class="plate-row"><span class="plate-key">Role</span><span class="role">{proprietor.title}</span></span>
      </figcaption>
    </figure>
    <div class="owner-text">
      <SectionHeader eyebrow="People" title="Who you deal with" />
      <div class="prose">
        <p>
          {site.name} was founded in {company.foundingDisplay} and is run by its proprietor, {proprietor.name}, from{' '}
          {site.address.locationWording}. Enquiries, repairs and site work are handled by a team of {company.teamSize}, and
          our engineers have {company.engineerExperience}' experience. We have served {company.clientCount} clients.
        </p>
        <p>
          Customers come to us for three things: the right product for the duty, a quick answer when something on the line
          breaks, and a repair they can rely on for any make. Workshop repairs are typically done in 2–3 days.
        </p>
      </div>
      <dl class="facts">
        {facts.map((f) => (
          <div>
            <dt>{f.key}</dt>
            <dd class:list={[f.key === 'Udyam' && company.udyam.number && 'mono']}>{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="split-band">
    <div class="container-content section-y">
      <SectionHeader eyebrow="Make and supply" title="What we make, and what we supply" />
      <div class="split">
        <div class="split-col" data-kind="make">
          <p class="eyebrow">Manufactured by {site.shortName}</p>
          <h3>{own} manual valves</h3>
          <p>We manufacture {site.brands.manufactured} under our own brand {own}.</p>
          <ul class="tiles" aria-label="Own brand">
            <li class="tile"><img src="/brand/sankoh-logo-full.svg" width="150" height="32" alt={own} loading="lazy" /><span class="tile-line">Own brand: {site.brands.manufactured}</span></li>
          </ul>
          <p class="eyebrow types-label">Manufacturer of</p>
          <ul class="types" aria-label={`${own} manual valve types`}>
            {madeLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          </ul>
          <a class="more" href="/products/manual-valves/">All {manualValves.length} manual valves<Icon name="arrow-right" size={18} /></a>
        </div>
        <div class="split-col" data-kind="supply">
          <p class="eyebrow">Supplied as authorised partner</p>
          <h3>Automated valves and process instruments</h3>
          <p>We supply these as an authorised partner; we do not manufacture them. We calibrate and repair valves and positioners, but we do not calibrate or repair instruments.</p>
          <ul class="tiles partners" aria-label="Authorised partners">
            {traded.map((t) => (
              <li class="tile">
                <PartnerLogo partnerKey={t.key} name={t.name} height={28} />
                <span class="tile-line">{t.line}</span>
              </li>
            ))}
          </ul>
          <a class="more" href="/brands/">About our brands<Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="container-content section-y"><SiteJobs /></section>

  <WhySankoh tone="paper" />
  <Trust />

  <section class="container-content section-y"><WhereWeWork /></section>

  <section class="container-content section-y location-section">
    <div class="location">
      <div>
        <SectionHeader eyebrow="Location" title={site.address.locationWording} />
        <address>
          {site.name}<br />
          {site.address.oneLine}
        </address>
        <p class="hours">{site.hours.display}. {site.hours.closed}.</p>
      </div>
      <div class="loc-actions">
        <Button href="/contact/" icon="phone">Contact us</Button>
        <a class="maplink" href={mapsHref()} target="_blank" rel="noopener"><Icon name="pin" size={20} />Open in Google Maps</a>
      </div>
    </div>
  </section>

  <CTABand />
</Base>

<style>
  /* Proprietor: photo in a drawing frame (cyan registration marks, offset blueprint backplate) with an
     equipment-style nameplate riveted over its bottom edge. On phones the photo is a square crop; from 640px
     it stretches to the height of the text beside it, so the two columns always end level. */
  .owner-section { display: grid; gap: 2.5rem; }
  .owner { position: relative; margin: 0 0 1.75rem; }
  .backplate { display: none; }
  .frame { position: relative; aspect-ratio: 1; border: 1px solid var(--color-line); background: var(--color-paper); }
  .frame :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 72%; }
  /* Registration marks: top-left and bottom-right corners, drawn just outside the photo. */
  .frame::before, .frame::after { content: ''; position: absolute; z-index: 1; width: 1.25rem; height: 1.25rem; pointer-events: none; }
  .frame::before { top: -0.5rem; left: -0.5rem; border-top: 2px solid var(--color-cyan); border-left: 2px solid var(--color-cyan); }
  .frame::after { right: -0.5rem; bottom: -0.5rem; border-right: 2px solid var(--color-cyan); border-bottom: 2px solid var(--color-cyan); }

  .plate {
    position: absolute; z-index: 2; left: 1rem; bottom: -1.75rem; max-width: calc(100% - 3rem);
    display: grid; gap: 0.25rem; padding: 0.875rem 1.5rem 0.875rem 1.375rem;
    background-color: var(--color-navy); color: var(--color-white); border-left: 4px solid var(--color-amber);
    box-shadow: 0 12px 24px -12px rgb(11 23 38 / 0.45);
    /* Four rivets, one in each corner. */
    background-image:
      radial-gradient(circle, rgb(255 255 255 / 0.4) 1.5px, transparent 2px),
      radial-gradient(circle, rgb(255 255 255 / 0.4) 1.5px, transparent 2px),
      radial-gradient(circle, rgb(255 255 255 / 0.4) 1.5px, transparent 2px),
      radial-gradient(circle, rgb(255 255 255 / 0.4) 1.5px, transparent 2px);
    background-size: 14px 14px;
    background-repeat: no-repeat;
    background-position: left 3px top 3px, right 3px top 3px, left 3px bottom 3px, right 3px bottom 3px;
  }
  .plate-co, .plate-key, .role { font-family: var(--font-mono); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .plate-co { margin-bottom: 0.25rem; padding-bottom: 0.375rem; border-bottom: 1px solid rgb(255 255 255 / 0.18); color: var(--color-cyan); }
  .plate-row { display: grid; grid-template-columns: 3.5rem auto; align-items: baseline; gap: 0.75rem; }
  .plate-key { color: rgb(255 255 255 / 0.55); }
  .name { font-size: 1.25rem; font-weight: 600; line-height: 1.3; }
  .role { color: var(--color-amber); }

  .owner-text { align-self: center; }
  .facts { display: grid; grid-template-columns: repeat(2, 1fr); margin-top: 1.75rem; max-width: 40rem; border: 1px solid var(--color-line); border-radius: 2px; }
  .facts div { padding: 0.75rem 1rem; border-top: 1px solid var(--color-line); }
  .facts div:nth-child(-n + 2) { border-top: 0; }
  .facts div:nth-child(even) { border-left: 1px solid var(--color-line); }
  /* An odd count: the last fact spans the row, so there is no empty cell. */
  .facts div:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .facts dt { color: var(--color-slate); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  .facts dd { margin-top: 0.125rem; color: var(--color-navy); font-weight: 600; overflow-wrap: anywhere; }
  .facts .mono { font-family: var(--font-mono); font-weight: 500; }

  .split-band { background: var(--color-paper); border-block: 1px solid var(--color-line); }
  .split { display: grid; gap: 1rem; margin-top: 1.75rem; }
  .split-col { padding: 1.5rem; background: var(--color-white); border: 1px solid var(--color-line); border-top: 4px solid var(--color-navy); border-radius: 2px; }
  .split-col[data-kind='supply'] { border-top-color: var(--color-blue); }
  .split-col .eyebrow { color: var(--color-slate); }
  .split-col h3 { margin-top: 0.5rem; font-size: 1.25rem; }
  .split-col { display: flex; flex-direction: column; }
  .split-col p:not(.eyebrow) { margin-top: 0.75rem; line-height: 1.55; }
  /* Logo tiles: the Sankoh® mark in the make card, the three partners in the supply card. */
  .tiles { display: grid; gap: 0.5rem; margin-top: 1.25rem; }
  /* Partners as rows (logo | range): no orphan tile on phones, and the card fills beside the make card. */
  .partners .tile { grid-template-columns: 9rem 1fr; justify-items: start; align-items: center; gap: 1rem; min-height: 4.5rem; text-align: left; }
  .partners .tile > :first-child { justify-self: center; }
  .tile { display: grid; justify-items: center; align-content: center; gap: 0.5rem; min-height: 5.5rem; padding: 0.875rem 0.75rem; border: 1px solid var(--color-line); border-radius: 2px; background: var(--color-paper); text-align: center; }
  .tile img { width: auto; max-width: 100%; height: 1.75rem; }
  .tile :global(.partner-logo) { height: 1.75rem; }
  .tile-line { color: var(--color-slate); font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; }
  .types-label { margin-top: 1.25rem; }
  .types { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }
  .types a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 0.875rem; border: 1px solid var(--color-line); border-radius: 2px; color: var(--color-navy); font-weight: 600; text-decoration: none; transition: background-color 0.15s, color 0.15s, border-color 0.15s; }
  .types a:hover { border-color: var(--color-navy); background: var(--color-navy); color: var(--color-white); }
  .more { display: inline-flex; align-items: center; gap: 0.375rem; align-self: start; min-height: 2.75rem; margin-top: auto; padding-top: 0.75rem; font-weight: 600; }
  @media (min-width: 768px) { .split { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; } }
  .owner-text .prose { margin-top: 1.5rem; max-width: 40rem; }

  /* Follows Where we work on the same white: one section gap between them, not two. */
  .location-section { padding-top: 0; }
  .location { display: grid; gap: 2rem; padding: 2rem; border: 1px solid var(--color-line); border-left: 4px solid var(--color-amber); border-radius: 2px; }
  address { margin-top: 1rem; font-style: normal; line-height: 1.6; }
  .hours { margin-top: 1rem; color: var(--color-slate); line-height: 1.6; }
  .hours strong { color: var(--color-navy); font-weight: 600; }
  .loc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .maplink { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 2.75rem; font-weight: 600; }

  @media (max-width: 767px) {
    /* Stacked: a square crop, capped so it never towers over the text on large phones and small tablets. */
    .owner { max-width: 28rem; }
  }
  @media (min-width: 768px) {
    .owner-section { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); align-items: stretch; gap: 3.5rem; }
    /* The photo fills the row: its height is the text column's (or the minimum below, whichever is taller). */
    .owner { display: flex; flex-direction: column; margin-bottom: 0; }
    .frame { flex: 1; aspect-ratio: auto; min-height: 24rem; }
    .backplate { display: block; position: absolute; top: 1.5rem; left: 1.5rem; right: -1.5rem; bottom: -1.5rem; overflow: hidden; background: var(--color-paper); border: 1px solid var(--color-line); }
    .frame { z-index: 1; }
    .plate { bottom: 1.25rem; left: -0.75rem; width: max-content; max-width: calc(100% + 1.5rem); }
  }
  @media (min-width: 1024px) {
    .owner-section { grid-template-columns: 22rem minmax(0, 1fr); gap: 5rem; }
    .location { grid-template-columns: 1fr auto; align-items: end; }
  }
</style>
