---
/** Drive repair service pages (SPEC §5.4). Content: src/content/repair-services/drive/*.md. */
import { getCollection, type CollectionEntry } from 'astro:content';
import RepairService from '../../components/RepairService.astro';

export async function getStaticPaths() {
  const services = await getCollection('repairServices', (s) => s.data.group === 'drive');
  return services.map((service) => ({ params: { service: service.id.split('/').pop()! }, props: { service } }));
}

interface Props {
  service: CollectionEntry<'repairServices'>;
}
const { service } = Astro.props;
---

<RepairService {service} />
