---
/**
 * Fact strip. Confirmed facts only (CLAUDE.md §4). The confirmed counts (founding, clients, repairs a year)
 * live in home/ProofStats.astro; never add ratings or unconfirmed numbers here.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props {
  tone?: 'light' | 'dark';
  /** 2 keeps the 2×2 grid at every width, for narrow columns. */
  columns?: 2 | 4;
  /**
   * Leave a tile out where the page already says it nearby: the support tile is the one allowed
   * mention per page (check:contact caps it), and the home repair band's headline carries the turnaround.
   */
  omit?: Array<'turnaround' | 'support'>;
}
const { tone = 'light', columns = 4, omit = [] } = Astro.props;

/** The support tile is the single place the breakdown support line is stated as a fact (label + the end of the sentence). */
const facts = [
  { key: 'make', icon: 'wrench', label: 'Any make', detail: 'Valves, actuators, positioners and VFDs' },
  { key: 'turnaround', icon: 'clock', label: 'Typically 2–3 days', detail: 'For workshop repairs' },
  { key: 'support', icon: 'calendar', label: site.service.supportLineShort, detail: site.service.supportLineTail },
  { key: 'team', icon: 'users', label: `Team of ${site.company.teamSize}`, detail: `Engineers with ${site.company.engineerExperience}' experience` },
].filter((fact) => !omit.includes(fact.key as 'turnaround' | 'support'));
---

<ul class:list={['facts', columns === 4 && 'wide']} data-tone={tone} style={`--cols: ${facts.length}`}>
  {facts.map((fact) => (
    <li>
      <Icon name={fact.icon} size={28} />
      <span class="label">{fact.label}</span>
      <span class="detail">{fact.detail}</span>
    </li>
  ))}
</ul>

<style>
  .facts { --rule: var(--color-line); --strong: var(--color-navy); --soft: var(--color-slate); --accent: var(--color-blue); display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid var(--rule); border-radius: 2px; }
  .facts[data-tone='dark'] { --rule: rgb(255 255 255 / 0.28); --strong: var(--color-white); --soft: rgb(255 255 255 / 0.78); --accent: var(--color-cyan); }
  li { display: grid; gap: 0.25rem; align-content: start; padding: 1.25rem 1rem; border-color: var(--rule); border-style: solid; border-width: 0; }
  li:nth-child(even) { border-left-width: 1px; }
  li:nth-child(n + 3) { border-top-width: 1px; }
  li :global(svg) { margin-bottom: 0.5rem; color: var(--accent); }
  .label { color: var(--strong); font-size: 1.125rem; font-weight: 600; line-height: 1.25; }
  .detail { color: var(--soft); font-size: var(--text-small); line-height: 1.45; }

  @media (min-width: 900px) {
    li { padding: 1.5rem; }
    .wide { grid-template-columns: repeat(var(--cols), 1fr); }
    .wide li:nth-child(n) { border-top-width: 0; border-left-width: 1px; }
    .wide li:first-child { border-left-width: 0; }
  }
</style>
