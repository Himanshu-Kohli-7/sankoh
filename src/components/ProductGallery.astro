---
/**
 * Product images as cut-outs on a paper tile with drawing-style corner marks (CLAUDE.md §6).
 * No JS: with more than one image the extra ones sit in a row below the main tile.
 * The first image is the page's LCP image, so it loads eagerly.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { DivisionKey } from '../config/nav';
import { placeholderPath } from '../lib/placeholder';

interface Props {
  images: { src: ImageMetadata; alt: string }[];
  /** Mono caption under the main image, e.g. the product name. */
  caption?: string;
  /** Picks the placeholder drawing when there is no photo. */
  division?: DivisionKey;
}
const { images, caption, division = 'valves' } = Astro.props;
const [main, ...rest] = images;
---

{!main && (
  <figure class="gallery">
    <div class="tile">
      <span class="mark tl"></span><span class="mark tr"></span><span class="mark bl"></span><span class="mark br"></span>
      <svg class="placeholder" viewBox="0 0 120 90" aria-hidden="true">
        <path d={placeholderPath(division)} />
      </svg>
    </div>
    {caption && <figcaption class="eyebrow">{caption}</figcaption>}
  </figure>
)}

{main && (
  <figure class="gallery">
    <div class="tile">
      <span class="mark tl"></span><span class="mark tr"></span><span class="mark bl"></span><span class="mark br"></span>
      <Image
        src={main.src}
        alt={main.alt}
        widths={[360, 540, 720]}
        sizes="(min-width: 1024px) 480px, 92vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>
    {rest.length > 0 && (
      <ul class="more">
        {rest.map((img) => (
          <li><Image src={img.src} alt={img.alt} widths={[160, 320]} sizes="160px" loading="lazy" /></li>
        ))}
      </ul>
    )}
    {caption && <figcaption class="eyebrow">{caption}</figcaption>}
  </figure>
)}

<style>
  .tile { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 2px; }
  .tile :global(img) { position: absolute; inset: 1.25rem; width: calc(100% - 2.5rem); height: calc(100% - 2.5rem); object-fit: contain; mix-blend-mode: multiply; }
  /* Same drawing as the card placeholder, for products without a (correct) photo. */
  .placeholder { width: 45%; fill: none; stroke: #b9c6d3; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  /* Corner marks, as on a drawing sheet. */
  .mark { position: absolute; width: 0.75rem; height: 0.75rem; border: 0 solid var(--color-navy); }
  .tl { top: 0.5rem; left: 0.5rem; border-top-width: 1.5px; border-left-width: 1.5px; }
  .tr { top: 0.5rem; right: 0.5rem; border-top-width: 1.5px; border-right-width: 1.5px; }
  .bl { bottom: 0.5rem; left: 0.5rem; border-bottom-width: 1.5px; border-left-width: 1.5px; }
  .br { bottom: 0.5rem; right: 0.5rem; border-bottom-width: 1.5px; border-right-width: 1.5px; }
  .more { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; margin-top: 0.5rem; }
  .more li { aspect-ratio: 1; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 2px; }
  .more :global(img) { width: 100%; height: 100%; padding: 0.375rem; object-fit: contain; mix-blend-mode: multiply; }
  figcaption { margin-top: 0.75rem; color: var(--color-slate); }
</style>
