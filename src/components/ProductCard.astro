---
/**
 * Product tile: cut-out image on paper, name, one-line summary. The whole card is the link.
 * Without `href` (a product whose page is not written yet) it renders as a plain, unlinked tile.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { DivisionKey } from '../config/nav';

interface Props {
  title: string;
  href?: string;
  summary?: string;
  image?: ImageMetadata;
  /** Describes the actual product (SPEC §7). */
  imageAlt?: string;
  division?: DivisionKey;
  headingLevel?: 'h2' | 'h3';
}
const { title, href, summary, image, imageAlt = title, division = 'valves', headingLevel: Tag = 'h3' } = Astro.props;
---

<article class:list={['card', !href && 'is-static']} data-division={division}>
  <div class="media">
    {image ? (
      <Image src={image} alt={imageAlt} widths={[240, 360, 480]} sizes="(min-width: 1024px) 280px, (min-width: 560px) 45vw, 90vw" loading="lazy" />
    ) : (
      <svg viewBox="0 0 120 90" aria-hidden="true">
        <path d="M30 30v30l30-15-30-15z M90 30v30L60 45l30-15z M60 45V24 M48 24h24 M10 45h20 M90 45h20" />
      </svg>
    )}
  </div>
  <div class="body">
    <Tag class="title">{href ? <a class="card-link" href={href}>{title}</a> : title}</Tag>
    {summary && <p class="summary">{summary}</p>}
  </div>
</article>

<style>
  /* Fixed 4:3 tile; the image is taken out of flow so it can never stretch the tile. */
  .media { position: relative; display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--color-paper); border-bottom: 1px solid var(--color-line); }
  .media :global(img) { position: absolute; inset: 0.75rem; width: calc(100% - 1.5rem); height: calc(100% - 1.5rem); object-fit: contain; mix-blend-mode: multiply; }
  .media svg { width: 60%; fill: none; stroke: #b9c6d3; stroke-width: 1.5; stroke-linejoin: round; stroke-linecap: round; }
  .body { padding: 0.875rem clamp(0.75rem, 4vw, 1.25rem) 1.25rem; }
  .title { font-size: 1.125rem; line-height: 1.3; }
  .card:not(.is-static):hover .title { color: var(--color-blue); }
  .is-static:hover { transform: none; border-color: var(--color-line); border-top-color: var(--division, var(--color-navy)); }
  .summary { margin-top: 0.5rem; color: var(--color-slate); font-size: 0.9375rem; line-height: 1.5; }
</style>
