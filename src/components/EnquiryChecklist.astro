---
/** "What to tell us when you enquire" — the per-category checklist from SPEC §5.2. */
interface Props {
  kind?: 'valve' | 'instrument' | 'accessory' | 'instrument-accessory' | 'analytical';
  /** Custom list, e.g. a repair page's "What to send us". Overrides `kind`. */
  items?: string[];
  title?: string;
  /** One line under the heading. */
  intro?: string;
  headingLevel?: 'h2' | 'h3';
}
const { kind = 'valve', items, title = 'What to tell us when you enquire', intro, headingLevel: Tag = 'h2' } = Astro.props;

const lists = {
  valve: ['Size', 'Pressure', 'Temperature', 'Media', 'Body material', 'End connection', 'Actuation', 'Quantity'],
  instrument: ['Media', 'Process connection', 'Range', 'Accuracy', 'Output signal', 'Power supply', 'Hazardous area', 'Quantity'],
  /** Positioners, limit switch boxes, converters, coils: matched to the valve and control system, not the pipe. */
  /** Siphons and similar fittings that protect a gauge: no range, signal or power to ask about. */
  'instrument-accessory': ['Media', 'Process connection', 'Gauge or instrument it protects', 'Pressure & temperature', 'Material', 'Quantity'],
  /** pH, BOD, COD and other analyzers: chosen by the sample and how it is presented to the sensor. */
  analytical: [
    'Sample type & source', 'Parameter & measuring range', 'Sample temperature & pressure', 'Installation (immersion, inline or flow cell)',
    'Transmitter or sensor it pairs with', 'Output signal & power supply', 'Access for cleaning and checks', 'Quantity',
  ],
  accessory: ['Make & model it fits', 'Valve type & size', 'Control signal', 'Supply voltage', 'Mounting', 'Location & enclosure', 'Quantity'],
};
---

<section class="checklist">
  <Tag class="title">{title}</Tag>
  {intro && <p class="intro">{intro}</p>}
  <ul>
    {(items ?? lists[kind]).map((item) => <li>{item}</li>)}
  </ul>
  <slot />
</section>

<style>
  .checklist { padding: 1.5rem; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 2px; }
  .title { font-size: var(--text-h3); }
  .intro { margin-top: 0.5rem; color: var(--color-slate); line-height: 1.5; }
  ul { display: grid; grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr)); gap: 0.25rem 1.5rem; margin-top: 1rem; }
  li { display: flex; align-items: center; gap: 0.75rem; min-height: 2.5rem; color: var(--color-ink); }
  /* An empty tick box, as on an enquiry form. */
  li::before { content: ''; flex: none; width: 1rem; height: 1rem; background: var(--color-white); border: 1.5px solid var(--color-navy); border-radius: 2px; }
</style>
