---
/**
 * Contact details from site.ts in two variants:
 * - full (Contact page only): primary number with call and WhatsApp, the sales line labelled
 *   "If you can’t reach us", email, hours with the breakdown support line, address and GSTIN.
 * - summary: address, hours with the breakdown support line, and labelled buttons.
 *   No number: the header strip and footer already show it.
 */
import Icon from '../Icon.astro';
import PhoneNumber from './PhoneNumber.astro';
import SalesLine from './SalesLine.astro';
import CallButton from './CallButton.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import QuoteButton from './QuoteButton.astro';
import { site } from '../../config/site';

interface Props {
  variant?: 'full' | 'summary';
}
const { variant = 'summary' } = Astro.props;
const { address } = site;
---

<div class="contact-card" data-variant={variant}>
  <dl class="details">
    {variant === 'full' && (
      <>
        <div>
          <dt><Icon name="phone" size={20} />Phone and WhatsApp</dt>
          <dd class="stack">
            <PhoneNumber withWhatsApp size="lg" />
            <SalesLine label="contact" />
          </dd>
        </div>
        <div>
          <dt><Icon name="mail" size={20} />Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
      </>
    )}
    <div>
      <dt><Icon name="clock" size={20} />Office hours</dt>
      <dd>
        <p class="text">
          {site.hours.display}. {site.hours.closed}.<br />
          <strong>{site.service.supportLine}</strong>
        </p>
      </dd>
    </div>
    <div>
      <dt><Icon name="pin" size={20} />Address</dt>
      <dd>
        <address>
          {site.name}<br />
          {address.line1}, {address.line2}<br />
          {address.locality} – {address.postalCode}, {address.district}<br />
          {address.region}, {address.country}
        </address>
      </dd>
    </div>
    {variant === 'full' && (
      <div>
        <dt><Icon name="report" size={20} />GSTIN</dt>
        <dd><span class="mono">{site.gstin}</span></dd>
      </div>
    )}
  </dl>

  {variant === 'summary' && (
    <div class="actions">
      <QuoteButton />
      <CallButton />
      <WhatsAppButton />
    </div>
  )}
</div>

<style>
  .details { border-top: 1px solid var(--color-line); }
  .details > div { display: grid; gap: 0.25rem; padding-block: 1rem; border-bottom: 1px solid var(--color-line); }
  dt { display: flex; align-items: center; gap: 0.5rem; color: var(--color-slate); font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  dt :global(svg) { color: var(--color-blue); }
  dd { display: flex; flex-wrap: wrap; gap: 0 1.5rem; color: var(--color-ink); }
  dd > a { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-navy); font-weight: 600; text-decoration: none; overflow-wrap: anywhere; }
  dd > a:hover { color: var(--color-blue); text-decoration: underline; text-underline-offset: 4px; }
  dd.stack { flex-direction: column; gap: 0; }
  .mono { font-family: var(--font-mono); font-weight: 500; }
  address, .text, dd > span.mono { padding-block: 0.375rem; font-style: normal; line-height: 1.55; }
  .text strong { color: var(--color-navy); font-weight: 600; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }
  @media (max-width: 479px) {
    .actions :global(.btn) { flex: 1 1 100%; }
  }
</style>
