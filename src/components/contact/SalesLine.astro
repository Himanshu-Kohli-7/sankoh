---
/**
 * The backup sales number as small secondary text, never a button and never in place of the primary.
 * Shown only in the footer ("Sales: …"), on the Contact page ("If you can’t reach us") and in error
 * states. `npm run check:contact` fails if it appears anywhere else (data-contact-sales).
 */
import { site, telHref } from '../../config/site';

interface Props {
  /** footer: "Sales: +91 …" · contact: "If you can’t reach us: Sales +91 …" */
  label?: 'footer' | 'contact';
  tone?: 'light' | 'dark';
  class?: string;
}
const { label = 'footer', tone = 'light', class: cls } = Astro.props;
const { salesPhone } = site;
---

<p class:list={['sales-line', cls]} data-tone={tone}>
  {label === 'contact' ? <>If you can’t reach us: {salesPhone.label}{' '}</> : <>{salesPhone.label}:{' '}</>}
  <a href={telHref(salesPhone)} data-event="click_call_sales" data-contact-sales>{salesPhone.display}</a>
</p>

<style>
  .sales-line { font-size: 0.875rem; line-height: 1.5; color: var(--color-slate); }
  .sales-line a { font-family: var(--font-mono); font-weight: 500; color: var(--color-navy); white-space: nowrap; text-decoration: none; }
  .sales-line a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .sales-line[data-tone='dark'] { color: rgb(255 255 255 / 0.7); }
  .sales-line[data-tone='dark'] a { color: rgb(255 255 255 / 0.9); }
</style>
