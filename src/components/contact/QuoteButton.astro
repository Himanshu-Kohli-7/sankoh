---
/** Quote / request button: links to the quote form, optionally with a product or service prefilled. */
import ActionLink from './ActionLink.astro';
import type { Variant, Tone } from './types';
import { quoteHref } from '../../config/site';

interface Props {
  label?: string;
  /** Slug to prefill (`?product=`), the only query string the site allows. */
  product?: string;
  variant?: Variant;
  tone?: Tone;
  size?: 'md' | 'sm';
  class?: string;
}
const { label = 'Get a quote', product, variant = 'primary', tone, size, class: cls } = Astro.props;
---

<ActionLink href={quoteHref(product)} icon="quote" {label} {variant} {tone} {size} class={cls} />
