---
/** Client logos: greyscale, colour on hover or focus (SPEC §6.3). Only clients with permission (CLAUDE.md §4). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Client {
  name: string;
  logo: ImageMetadata;
}

interface Props {
  clients: Client[];
}
const { clients } = Astro.props;
---

<ul class="logos">
  {clients.map((client) => (
    <li data-logo>
      <Image class="logo-mono" src={client.logo} alt={client.name} height={96} loading="lazy" />
    </li>
  ))}
</ul>

<style>
  /* 3 columns on phones, 5 from 768px, 7 on desktop (14 logos: two even rows). */
  .logos { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--color-line); border-left: 1px solid var(--color-line); }
  li { display: grid; place-items: center; height: 4.5rem; padding: 0.75rem; background: var(--color-white); border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  li :global(img) { width: auto; height: auto; max-width: 100%; max-height: 2.25rem; object-fit: contain; }

  @media (min-width: 768px) {
    .logos { grid-template-columns: repeat(5, 1fr); }
    li { height: 5.5rem; padding: 1rem; }
    li :global(img) { max-height: 2.75rem; }
  }
  @media (min-width: 1024px) { .logos { grid-template-columns: repeat(7, 1fr); } }
</style>
