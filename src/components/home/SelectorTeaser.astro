---
/**
 * Product selector (home §6): plain links that open /product-selector/ with one filter applied,
 * plus the company-named applications as chips (config/applications.ts), which replace the
 * separate Applications section. Filter state lives in the URL hash (SPEC §6.2) as
 * `#<filter>=<value>` — the selector must read this format.
 */
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { site } from '../../config/site';
import { selectorHref } from '../../config/nav';
import { applications } from '../../config/applications';
import { selectorData, slugify } from '../../lib/selector';

/** Application chips link to the selector only where it has a matching filter option. */
const { filters } = await selectorData();
const liveApplications = new Set(filters.find((f) => f.key === 'application')?.options.map((o) => o.value) ?? []);
const link = (filter: string, value: string) => `${selectorHref}#${filter}=${slugify(value)}`;

const rows = [
  { label: 'Operation', filter: 'operation', options: ['Manual', 'Self-acting', 'Pneumatic', 'Electric', 'Solenoid'] },
  { label: 'Media', filter: 'media', options: [...site.media] },
];
const appChips = applications.map((app) => ({
  ...app,
  href: app.industryHref ?? (liveApplications.has(app.slug) ? `${selectorHref}#application=${app.slug}` : undefined),
}));
---

<section class="section-compact selector">
  <div class="container-content section-y teaser">
    <SectionHeader
      eyebrow="Product selector"
      division="instruments"
      title="Not sure which product you need?"
      intro="Start with how the valve is operated, what flows through it or where it is used, and narrow the list from there."
    />
    <div class="panel">
      {rows.map((row) => (
        <div class="row">
          <p class="eyebrow label">{row.label}</p>
          <ul class="chips">
            {row.options.map((option) => (
              <li><a href={link(row.filter, option)}>{option}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div class="row">
        <p class="eyebrow label">Applications</p>
        <ul class="chips apps">
          {appChips.map((app) => (
            <li>
              {app.href ? (
                <a href={app.href}><Icon name={app.icon} size={18} />{app.name}</a>
              ) : (
                <span><Icon name={app.icon} size={18} />{app.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
      <a class="open" href={selectorHref}>Open the product selector<Icon name="arrow-right" size={20} /></a>
    </div>
  </div>
</section>

<style>
  .selector { background: var(--color-paper); border-top: 4px solid var(--color-blue); border-bottom: 1px solid var(--color-line); }
  .teaser { display: grid; gap: 1.75rem; }
  .panel { border: 1px solid var(--color-line); border-radius: 2px; background: var(--color-white); }
  .row { display: grid; gap: 0.5rem; padding: 1rem 1.25rem; border-bottom: 1px solid var(--color-line); }
  .label { color: var(--color-slate); }
  .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .chips a, .chips span { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 2.75rem; padding: 0 0.875rem; border: 1px solid #b9c6d3; border-radius: 2px; color: var(--color-navy); font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: background-color 0.15s, color 0.15s, border-color 0.15s; }
  .chips a:hover { background: var(--color-navy); border-color: var(--color-navy); color: var(--color-white); }
  .apps :global(svg) { flex: none; color: var(--color-blue); }
  .apps a:hover :global(svg) { color: inherit; }
  /* A label, not a link: dashed frame, regular weight. */
  .chips span { border-style: dashed; font-weight: 400; }
  .open { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 3.25rem; padding: 0 1.25rem; background: var(--color-paper); color: var(--color-navy); font-weight: 600; text-decoration: none; }
  .open:hover { background: var(--color-navy); color: var(--color-white); }

  /* Phones: each row of chips is one swipeable line. */
  @media (max-width: 639px) {
    .row { padding-inline: 0; }
    .label { padding-inline: 1.25rem; }
    .chips { flex-wrap: nowrap; overflow-x: auto; padding: 0 1.25rem 0.25rem; scroll-padding-inline: 1.25rem; }
    .chips li { flex: none; }
    .chips a, .chips span { white-space: nowrap; }
  }
  @media (min-width: 640px) {
    .row { grid-template-columns: 7.5rem 1fr; align-items: center; }
  }
  @media (min-width: 1024px) {
    /* Top-aligned, the heading column sticky beside the taller panel: no empty band above the heading. */
    .teaser { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); gap: 4rem; align-items: start; }
    .teaser > :global(:first-child) { position: sticky; top: 6.5rem; }
  }
</style>
