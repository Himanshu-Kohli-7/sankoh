---
/**
 * Product selector teaser (SPEC §3.5): plain links that open /product-selector/ with one filter applied.
 * Filter state lives in the URL hash (SPEC §6.2) as `#<filter>=<value>` — the selector must read this format.
 */
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { site } from '../../config/site';
import { selectorHref } from '../../config/nav';

const rows = [
  {
    label: 'Operation',
    filter: 'operation',
    options: ['Manual', 'Self-acting', 'Pneumatic', 'Electric', 'Solenoid'],
  },
  {
    label: 'Media',
    filter: 'media',
    options: [...site.media],
  },
];
/** Same slugs as lib/selector.ts: "Self-acting" → self-acting. */
const link = (filter: string, value: string) => `${selectorHref}#${filter}=${value.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class="container-content section-y">
  <div class="teaser">
    <SectionHeader
      eyebrow="Product selector"
      title="Not sure which product you need?"
      intro="Start with how the valve is operated or what flows through it, and narrow the list from there."
    />
    <div class="panel">
      {rows.map((row) => (
        <div class="row">
          <p class="eyebrow label">{row.label}</p>
          <ul>
            {row.options.map((option) => (
              <li><a href={link(row.filter, option)}>{option}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <a class="open" href={selectorHref}>Open the product selector<Icon name="arrow-right" size={20} /></a>
    </div>
  </div>
</section>

<style>
  .teaser { display: grid; gap: 2rem; }
  .panel { border: 1px solid var(--color-line); border-top: 4px solid var(--color-blue); border-radius: 2px; background: var(--color-white); }
  .row { display: grid; gap: 0.625rem; padding: 1.25rem; border-bottom: 1px solid var(--color-line); }
  .label { color: var(--color-slate); }
  ul { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  li a { display: inline-flex; align-items: center; min-height: 2.75rem; padding: 0 1rem; border: 1px solid #b9c6d3; border-radius: 2px; color: var(--color-navy); font-weight: 600; font-size: 0.9375rem; text-decoration: none; transition: background-color 0.15s, color 0.15s, border-color 0.15s; }
  li a:hover { background: var(--color-navy); border-color: var(--color-navy); color: var(--color-white); }
  .open { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 3.25rem; padding: 0 1.25rem; background: var(--color-paper); color: var(--color-navy); font-weight: 600; text-decoration: none; }
  .open:hover { background: var(--color-navy); color: var(--color-white); }

  @media (min-width: 640px) {
    .row { grid-template-columns: 7rem 1fr; align-items: center; }
  }
  @media (min-width: 1024px) {
    .teaser { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: 4rem; align-items: center; }
  }
</style>
