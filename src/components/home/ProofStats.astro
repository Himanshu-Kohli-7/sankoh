---
/**
 * Home proof stats (proprietor, 21 Nov 2026): founding, client count and valves repaired a year.
 * These three only, all from site.ts. Never add another number here (CLAUDE.md §2.1).
 */
import { site } from '../../config/site';

const stats = [
  { value: site.company.foundingDisplay, label: 'In business since' },
  { value: site.company.clientCount, label: 'Clients served' },
  { value: site.service.repairsPerYear, label: 'Valves repaired a year' },
];
---

<dl class="stats">
  {stats.map((s) => (
    <div>
      <dt>{s.label}</dt>
      <dd>{s.value}</dd>
    </div>
  ))}
</dl>

<style>
  .stats { display: grid; margin-top: 1.75rem; border: 1px solid var(--color-line); border-radius: 2px; background: var(--color-white); }
  .stats div { display: flex; flex-direction: column-reverse; gap: 0.125rem; padding: 0.75rem 1rem; border-top: 1px solid var(--color-line); }
  .stats div:first-child { border-top: 0; }
  dt { color: var(--color-slate); font-family: var(--font-mono); font-size: var(--text-eyebrow, 0.75rem); font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  dd { color: var(--color-navy); font-family: var(--font-mono); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); font-weight: 500; line-height: 1.15; font-variant-numeric: tabular-nums; }

  @media (min-width: 640px) {
    .stats { grid-template-columns: repeat(3, 1fr); }
    .stats div { border-top: 0; border-left: 1px solid var(--color-line); padding: 1.25rem 1.5rem; }
    .stats div:first-child { border-left: 0; }
  }
</style>
