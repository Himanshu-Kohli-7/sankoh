---
/** Three division cards in their own colours (SPEC §3.2), each linking to its hub. */
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { site } from '../../config/site';
import { productGroups, repairGroups } from '../../config/nav';

const [valves, instruments] = productGroups;
const [valveRepair, driveRepair] = repairGroups;

const divisions = [
  {
    key: 'valves',
    code: '01',
    name: site.divisions.valves.name,
    href: valves.href,
    text: 'Manual, pneumatic, electric and solenoid valves, plus automation accessories.',
    cta: 'See valves and automation',
    links: valves.links,
  },
  {
    key: 'instruments',
    code: '02',
    name: site.divisions.instruments.name,
    href: instruments.href,
    text: 'Flow, pressure, temperature, level and analytical instruments.',
    cta: 'See instruments and analyzers',
    links: instruments.links,
  },
  {
    key: 'repair',
    code: '03',
    name: site.divisions.repair.name,
    href: valveRepair.href,
    text: 'Valves, actuators, cylinders and positioners of any make. VFDs, servo drives and HMIs of any make.',
    cta: 'See valve repair',
    links: [
      { label: valveRepair.label, href: valveRepair.href },
      { label: `${driveRepair.label} (VFD, servo, HMI)`, href: driveRepair.href },
      { label: site.service.advisory.name, href: '/services/valve-selection-maintenance-advisory/' },
      { label: 'Product Sourcing', href: '/services/product-sourcing/' },
      { label: 'Surplus & Discontinued Valves', href: '/services/surplus-discontinued-valves/' },
    ],
  },
];
---

<section class="container-content section-y">
  <SectionHeader
    eyebrow="What we do"
    title="Three divisions under one roof"
    intro="We manufacture, supply and source industrial valves, valve automation and process instruments, and repair valves and drives of any make."
  />
  <ul class="grid">
    {divisions.map((d) => (
      <li class="division" data-key={d.key} data-reveal>
        <div class="head">
          <p class="eyebrow">Division / {d.code}</p>
          <h3><a href={d.href}>{d.name}</a></h3>
          <p class="text">{d.text}</p>
        </div>
        <ul class="links">
          {d.links.map((link) => (
            <li><a href={link.href}>{link.label}<Icon name="chevron-right" size={18} /></a></li>
          ))}
        </ul>
        <a class="cta" href={d.href}>{d.cta}<Icon name="arrow-right" size={20} /></a>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid { display: grid; gap: 1.25rem; margin-top: 2.5rem; }
  .division { --bg: var(--color-navy); --fg: var(--color-white); --soft: rgb(255 255 255 / 0.85); display: flex; flex-direction: column; border: 1px solid var(--color-line); border-radius: 2px; background: var(--color-white); }
  .division[data-key='instruments'] { --bg: var(--color-blue); }
  .division[data-key='repair'] { --bg: var(--color-amber); --fg: var(--color-navy); --soft: var(--color-navy); }
  .head { padding: 1.5rem 1.5rem 1.75rem; background: var(--bg); color: var(--fg); }
  .head .eyebrow { color: var(--soft); }
  h3 { margin-top: 0.375rem; color: var(--fg); font-size: 1.625rem; }
  h3 a { display: inline-block; padding-block: 0.375rem; color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; text-underline-offset: 5px; }
  .text { margin-top: 0.375rem; color: var(--soft); font-size: 1rem; line-height: 1.5; }
  .head :global(:focus-visible) { outline-color: var(--fg); }

  .links { flex: 1; padding: 0.5rem 1.5rem; }
  .links li + li { border-top: 1px solid var(--color-line); }
  .links a { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 2.875rem; color: var(--color-ink); font-size: 1rem; text-decoration: none; }
  .links a:hover { color: var(--color-blue); }
  .links :global(svg) { flex: none; color: var(--color-slate); }
  .cta { display: flex; align-items: center; justify-content: space-between; gap: 0.75rem; min-height: 3.25rem; margin-top: 0.5rem; padding: 0 1.5rem; border-top: 1px solid var(--color-line); background: var(--color-paper); color: var(--color-navy); font-weight: 600; text-decoration: none; }
  .cta:hover { background: var(--color-navy); color: var(--color-white); }

  /* Phones: the category grid and repair band right below list the same links. */
  @media (max-width: 899px) {
    .links { display: none; }
    .cta { margin-top: 0; border-top: 0; }
  }
  @media (min-width: 900px) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .head { min-height: 11.5rem; }
  }
</style>
