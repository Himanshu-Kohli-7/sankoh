---
/**
 * Brands strip (SPEC §3.6): our own brand and the authorised partners, labelled as such.
 * Partner logos come from src/config/partnerLogos.ts (permission confirmed 18 Nov 2026); a partner
 * with no logo file is a text name. No other third-party logos, ever (CLAUDE.md §2.4).
 */
import Icon from '../Icon.astro';
import PartnerLogo from '../PartnerLogo.astro';
import { site } from '../../config/site';

const groups = [
  { key: 'own', label: 'Own brand', names: site.brands.own },
  { key: 'partners', label: 'Authorised partner of', names: site.brands.authorisedPartners },
];
---

<section class="brands">
  <div class="container-content inner">
    <div class="head">
      <h2>Brands</h2>
      <a href="/brands/">About our brands<Icon name="arrow-right" size={20} /></a>
    </div>
    <div class="groups">
      {groups.map((group) => (
        <div class="group" data-key={group.key}>
          <p class="eyebrow label">{group.label}</p>
          <ul>
            {group.names.map((name) => (
              <li data-logo>
                {name === 'Sankoh®' ? (
                  <img src="/brand/sankoh-logo-full.svg" width="169" height="36" alt="Sankoh®" loading="lazy" />
                ) : (
                  <PartnerLogo partnerKey={name.split(' ')[0].toLowerCase()} {name} height={36} />
                )}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .brands { border-top: 1px solid var(--color-line); }
  .inner { padding-block: 3rem; }
  .head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 2rem; }
  h2 { font-size: var(--text-h3); }
  .head a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; font-weight: 600; }
  .groups { display: grid; gap: 1.25rem; margin-top: 1.25rem; }
  .group { border: 1px solid var(--color-line); border-radius: 2px; }
  .label { padding: 0.75rem 1.25rem; border-bottom: 1px solid var(--color-line); background: var(--color-paper); color: var(--color-slate); }
  ul { display: grid; }
  li { display: grid; place-items: center; min-height: 5.5rem; padding: 1rem; text-align: center; }
  li + li { border-top: 1px solid var(--color-line); }
  img { width: auto; height: 2.25rem; max-width: 100%; }

  @media (min-width: 900px) {
    .groups { grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: 1.5rem; }
    [data-key='partners'] ul { grid-template-columns: repeat(3, 1fr); }
    [data-key='partners'] li + li { border-top: 0; border-left: 1px solid var(--color-line); }
  }
</style>
