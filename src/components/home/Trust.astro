---
/**
 * Trust (SPEC §3.9, §6.3): client logos and reviews from the content collections, exactly as on the
 * old site. Certifications appear only once their collection has real entries (CLAUDE.md §8): no empty
 * headings. Site jobs have their own block (components/SiteJobs.astro), kept away from the client logos. Plain HTML, no Review/AggregateRating schema.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ClientLogoStrip from '../ClientLogoStrip.astro';
import ReviewCard from '../ReviewCard.astro';
import SectionHeader from '../SectionHeader.astro';

const byOrder = (a: { data: { order: number } }, b: { data: { order: number } }) => a.data.order - b.data.order;
const clients = (await getCollection('clients')).sort(byOrder).map((entry) => entry.data);
const reviews = (await getCollection('reviews')).sort(byOrder).map((entry) => entry.data);
const certifications = (await getCollection('certifications')).sort(byOrder).map((entry) => entry.data);
---

<section class="trust">
  <div class="container-content section-y">
    <SectionHeader eyebrow="Clients" title="Companies we work with" />
    <div class="logos-wrap"><ClientLogoStrip clients={clients} /></div>

    {reviews.length > 0 && (
      <>
        <h3 class="block-title" id="reviews">What their engineers say</h3>
        <ul class="reviews" tabindex="0" aria-label="Client reviews">
          {reviews.map((review) => (
            <li>
              <ReviewCard quote={review.quote} name={review.name} role={review.role} company={review.company} logo={review.logo} />
            </li>
          ))}
        </ul>
      </>
    )}

    {certifications.length > 0 && (
      <>
        <h3 class="block-title">Certifications</h3>
        <ul class="certs">
          {certifications.map((c) => (
            <li>
              <Image src={c.image} alt={c.alt} widths={[240, 360]} sizes="240px" loading="lazy" />
              <p class="cert-title">{c.title}</p>
              <p class="cert-issuer">{c.issuer}</p>
            </li>
          ))}
        </ul>
      </>
    )}

  </div>
</section>

<style>
  .trust { background: var(--color-paper); border-block: 1px solid var(--color-line); }
  .logos-wrap { margin-top: 2rem; }
  .block-title { margin-top: 3rem; }
  /* Phones: one swipeable row, so six reviews don't add six screens of scrolling. */
  .reviews { display: flex; gap: 0.75rem; margin-top: 1.25rem; margin-inline: calc(var(--gutter) * -1); padding: 0.25rem var(--gutter) 0.75rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); }
  .reviews li { flex: none; width: 84%; max-width: 22rem; scroll-snap-align: start; }

  .certs { display: grid; gap: 1rem; margin-top: 1.25rem; }
  .certs { grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr)); }
  .certs li { padding: 1rem; border: 1px solid var(--color-line); border-radius: 2px; background: var(--color-white); }
  .certs :global(img) { width: 100%; height: auto; }
  .cert-title { margin-top: 0.75rem; color: var(--color-navy); font-weight: 600; }
  .cert-issuer { color: var(--color-slate); font-size: 0.875rem; }

  @media (min-width: 768px) {
    .reviews { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; margin-inline: 0; padding: 0; overflow: visible; }
    .reviews li { width: auto; max-width: none; }
  }
  @media (min-width: 1024px) {
    .reviews { grid-template-columns: repeat(3, 1fr); }
    /* 14 logos: two even rows of seven. */
    .logos-wrap :global(.logos) { grid-template-columns: repeat(7, 1fr); }
  }
</style>
