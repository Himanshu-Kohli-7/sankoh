---
/**
 * "What we supply" (home §2): the three divisions as columns, each listing its five entries,
 * closed by one sourcing line. Replaces the separate division cards and category grid, so every
 * link here appears once. Product thumbnails are the first image of the first published product
 * in each category (already mark-checked); the repair column has no photos (CLAUDE.md §2.3), so
 * it uses line icons.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { site, quoteHref } from '../../config/site';
import { categoryBlurbs, productGroups, productsHref, repairGroups, type DivisionKey } from '../../config/nav';
import { isPublished } from '../../lib/content';

interface Row {
  label: string;
  href: string;
  blurb: string;
  icon: string;
  thumb?: { src: ImageMetadata; alt: string };
}
interface Column {
  key: DivisionKey;
  code: string;
  name: string;
  href: string;
  rows: Row[];
}

const products = (await getCollection('products', isPublished)).sort((a, b) => a.data.order - b.data.order);
const thumbFor = (href: string) => {
  const slug = href.split('/').filter(Boolean).pop();
  return products.find((p) => p.data.category === slug && p.data.images.length > 0)?.data.images[0];
};

const [valveRepair, vfdRepair] = repairGroups;
const columns: Column[] = [
  ...productGroups.map((group, i) => ({
    key: group.division,
    code: `0${i + 1}`,
    name: group.label,
    href: group.href,
    rows: group.links.map((link) => ({
      label: link.label,
      href: link.href,
      blurb: categoryBlurbs[link.href],
      icon: link.icon ?? 'valve',
      thumb: thumbFor(link.href),
    })),
  })),
  {
    key: 'repair',
    code: '03',
    name: site.divisions.repair.name,
    href: '/services/',
    rows: [
      { label: valveRepair.label, href: valveRepair.href, icon: 'wrench', blurb: `${site.service.repairScope.valves}.` },
      { label: vfdRepair.label, href: vfdRepair.href, icon: 'drive', blurb: `VFDs of any make: ${site.service.vfdBrands}.` },
      { label: site.service.advisory.name, href: '/services/valve-selection-maintenance-advisory/', icon: 'search', blurb: `${site.service.advisory.description}.` },
      { label: 'Installation & Commissioning', href: '/services/installation-commissioning/', icon: 'factory', blurb: 'Delivery, installation, testing and commissioning.' },
      { label: 'Surplus & Discontinued Valves', href: '/services/surplus-discontinued-valves/', icon: 'box', blurb: 'Surplus and discontinued valves and parts, reconditioned components.' },
    ],
  },
];
---

<section class="supply">
  <div class="container-content section-y">
    <div class="top">
      <SectionHeader
        eyebrow="What we supply"
        title="Valves, instruments and repair"
        intro="We manufacture, supply and source industrial valves, valve automation and process instruments, and repair valves and VFDs of any make."
      />
      <a class="all" href={productsHref}>All products<Icon name="arrow-right" size={20} /></a>
    </div>

    <div class="columns">
      {columns.map((col) => (
        <div class="col" data-division={col.key}>
          <h3 class="head">
            <span class="eyebrow">Division / {col.code}</span>
            <a href={col.href}>{col.name}<Icon name="arrow-right" size={20} /></a>
          </h3>
          <ul class="rows">
            {col.rows.map((row) => (
              <li>
                <a href={row.href}>
                  <span class="thumb">
                    {row.thumb ? (
                      <Image src={row.thumb.src} alt="" widths={[64, 128]} width={128} sizes="64px" loading="lazy" />
                    ) : (
                      <Icon name={row.icon} size={28} />
                    )}
                  </span>
                  <span class="text">
                    <span class="label">{row.label}</span>
                    {row.blurb && <span class="blurb">{row.blurb}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <p class="source">
      <span class="source-title">Can’t find what you need? We’ll source it.</span>
      <span class="source-text">We trade through a vendor network and can source products that aren’t listed here, to your specification.</span>
      <span class="source-links">
        <a href={quoteHref()}>Ask us to source it</a>
        <a href="/services/product-sourcing/">How product sourcing works</a>
      </span>
    </p>
  </div>
</section>

<style>
  .supply { background: var(--color-paper); border-block: 1px solid var(--color-line); }
  .top { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; }
  .all { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; font-weight: 600; }

  .columns { display: grid; gap: 1.25rem; margin-top: 2rem; }
  .col { display: flex; flex-direction: column; background: var(--color-white); border: 1px solid var(--color-line); border-top: 4px solid var(--division); border-radius: 2px; }
  .head { display: grid; gap: 0.125rem; padding: 1rem 1.25rem 0.75rem; border-bottom: 1px solid var(--color-line); font-size: 1.25rem; }
  .head .eyebrow { color: var(--color-slate); }
  .head a { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; color: var(--color-navy); text-decoration: none; }
  .head a :global(svg) { flex: none; color: var(--division-text); }
  .head a:hover { text-decoration: underline; text-underline-offset: 5px; }

  .rows li + li { border-top: 1px solid var(--color-line); }
  .rows a { display: flex; align-items: center; gap: 0.875rem; min-height: 4rem; padding: 0.5rem 1.25rem; color: var(--color-ink); text-decoration: none; }
  .rows a:hover { background: var(--color-paper); }
  .rows a:hover .label { color: var(--color-blue); text-decoration: underline; text-underline-offset: 3px; }
  .rows a:focus-visible { outline-offset: -3px; }
  .thumb { flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 2px; color: var(--division-text); }
  .thumb :global(img) { width: 100%; height: 100%; padding: 0.25rem; object-fit: contain; mix-blend-mode: multiply; }
  .text { display: grid; min-width: 0; }
  .label { color: var(--color-navy); font-weight: 600; line-height: 1.3; }
  .blurb { display: none; color: var(--color-slate); font-size: 0.875rem; line-height: 1.4; }

  .source { display: grid; gap: 0.375rem; margin-top: 1.5rem; padding: 1.25rem; background: var(--color-white); border: 1.5px dashed var(--color-blue); border-radius: 2px; }
  .source-title { color: var(--color-navy); font-size: 1.125rem; font-weight: 600; }
  .source-text { color: var(--color-slate); font-size: 0.9375rem; line-height: 1.5; }
  .source-links { display: flex; flex-wrap: wrap; gap: 0 1.5rem; }
  .source-links a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; text-underline-offset: 3px; }

  @media (min-width: 900px) {
    .columns { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; }
    .blurb { display: block; }
    .rows a { align-items: flex-start; padding-block: 0.875rem; }
    .thumb { width: 3.5rem; height: 3.5rem; }
    .source { grid-template-columns: 1fr auto; align-items: center; column-gap: 2rem; padding: 1.25rem 1.75rem; }
    .source-text { grid-column: 1; }
    .source-links { grid-column: 2; grid-row: 1 / span 2; flex-direction: column; }
  }
</style>
