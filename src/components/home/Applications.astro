---
/** Applications named by the company (SPEC §3.8, CLAUDE.md §4). Icons only — no pages in phase 1. */
import Icon from '../Icon.astro';
import SectionHeader from '../SectionHeader.astro';
import { site } from '../../config/site';

const icons: Record<string, string> = {
  'Water treatment': 'water',
  HVAC: 'fan',
  'Building automation': 'building',
  'Industrial automation': 'factory',
  'Water/milk ATMs': 'dispenser',
};
---

<section class="container-content section-y">
  <SectionHeader
    eyebrow="Applications"
    division="instruments"
    title="Where our valves and instruments are used"
  />
  <ul class="grid">
    {site.applications.map((name) => (
      <li>
        <Icon name={icons[name] ?? 'valve'} size={36} />
        <span>{name}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-top: 2rem; }
  li { display: grid; gap: 0.875rem; align-content: start; padding: 1.25rem; border: 1px solid var(--color-line); border-bottom: 3px solid var(--color-cyan); border-radius: 2px; color: var(--color-navy); font-weight: 600; line-height: 1.3; }
  li :global(svg) { color: var(--color-blue); }
  li:last-child:nth-child(odd) { grid-column: 1 / -1; }

  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    li:last-child:nth-child(odd) { grid-column: auto; }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(5, 1fr); }
    li { padding: 1.5rem; }
  }
</style>
