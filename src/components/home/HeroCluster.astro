---
/**
 * Hero product cluster (SPEC §3): four real product cut-outs on tiles, joined by a thin pipeline.
 * Images come from the old site's product photos. The first tile is the LCP image (fetchpriority high).
 * Below 640px the tiles are a horizontal strip: the first two load eagerly, the last two lazily
 * (they start off-screen). From 640px up the script after the list makes all four eager.
 * Each image sits on a paper background, so a tile is never blank while it loads.
 */
import { Image } from 'astro:assets';
import pneumaticBall from '../../assets/products/pneumatic-actuated-ball-valve.png';
import globeControl from '../../assets/products/pneumatic-globe-control-valve.png';
import electricBall from '../../assets/products/electric-actuated-ball-valve.png';
/** Background cleaned to a transparent cut-out from the partner photo electromagnetic-flow-meter.jpg (the product page keeps the original). */
import flowMeter from '../../assets/products/electromagnetic-flow-meter-hero.webp';

const tiles = [
  {
    code: 'V-01',
    division: 'valves',
    name: 'Pneumatic actuated ball valve',
    href: '/products/pneumatic-actuated-valves/pneumatic-actuated-ball-valve/',
    image: pneumaticBall,
    alt: 'Flanged ball valve fitted with a pneumatic actuator and limit switch box',
  },
  {
    code: 'V-02',
    division: 'valves',
    name: 'Pneumatic globe control valve',
    href: '/products/pneumatic-actuated-valves/pneumatic-globe-control-valve/',
    image: globeControl,
    alt: 'Globe control valve with a diaphragm actuator and positioner',
  },
  {
    code: 'I-01',
    division: 'instruments',
    name: 'Electromagnetic flow meter',
    href: '/products/flow-meters/electromagnetic-flow-meter/',
    image: flowMeter,
    alt: 'Flanged electromagnetic flow meter with a display transmitter',
  },
  {
    code: 'V-03',
    division: 'valves',
    name: 'Electric actuated ball valve',
    href: '/products/electric-actuated-valves/electric-actuated-ball-valve/',
    image: electricBall,
    alt: 'Screwed-end ball valve fitted with an electric actuator and handwheel',
  },
] as const;
---

<div class="cluster">
  <svg class="pipes" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path class="base" d="M-12 22 H25 V74 H75 V30 H106"></path>
    <path class="pipe-flow flow" d="M-12 22 H25 V74 H75 V30 H106"></path>
  </svg>
  <ul class="tiles">
    {tiles.map((tile, i) => (
      <li class="tile" data-division={tile.division}>
        <Image
          src={tile.image}
          alt={tile.alt}
          widths={[200, 320, 440]}
          sizes="(min-width: 1024px) 220px, (min-width: 640px) 22vw, 44vw"
          width={440}
          loading={i < 2 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
          data-hero-late={i < 2 ? undefined : ''}
        />
        <p class="tag">
          <span class="code">{tile.code}</span>
          <a href={tile.href}>{tile.name}</a>
        </p>
      </li>
    ))}
  </ul>
  <script is:inline>
    // From 640px all four tiles are in view: load the last two eagerly too. Runs as the parser reaches it.
    if (matchMedia('(min-width: 640px)').matches) document.querySelectorAll('[data-hero-late]').forEach((img) => { img.loading = 'eager'; });
    // Phones: the browser does not scroll a half-visible tile into view on focus, so Tab could leave its focus ring off-screen.
    document.currentScript.previousElementSibling.addEventListener('focusin', (e) => e.target.closest('.tile')?.scrollIntoView({ block: 'nearest', inline: 'nearest' }));
  </script>
</div>

<style>
  .cluster { position: relative; }
  .pipes { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .pipes path { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; }
  .base { stroke: var(--color-cyan); }
  .flow { stroke: var(--color-blue); }

  /* Phones: one swipeable row; two tiles in view, the next one peeking. */
  /* No visible scrollbar: the peeking third tile is the swipe cue. Swipe, trackpad and keyboard scrolling
     (Tab to each tile link, arrow keys while one has focus) still work because overflow stays auto. */
  .tiles { position: relative; display: flex; gap: 0.75rem; margin-inline: calc(var(--gutter) * -1); padding: 0.25rem var(--gutter) 0.5rem; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter); scrollbar-width: none; }
  .tiles::-webkit-scrollbar { display: none; }
  .tile { position: relative; flex: none; width: 44%; scroll-snap-align: start; display: flex; flex-direction: column; background: var(--color-white); border: 1px solid var(--color-line); border-top: 4px solid var(--division); border-radius: 2px; transition: transform 0.15s, border-color 0.15s; }
  .tile:hover { transform: translateY(-3px); border-color: #b9c6d3; border-top-color: var(--division); }
  /* Paper behind the cut-out: the placeholder until the image arrives. */
  .tile :global(img) { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; padding: 0.625rem; background: var(--color-paper); }
  .tag { display: grid; gap: 0.125rem; padding: 0.5rem 0.75rem 0.75rem; }
  .code { color: var(--color-slate); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; }
  .tag a { color: var(--color-navy); font-size: 0.875rem; font-weight: 600; line-height: 1.3; text-decoration: none; }
  .tag a::after { content: ''; position: absolute; inset: 0; }
  .tile:hover .tag a { color: var(--color-blue); }
  .tag a:focus-visible { outline: none; }
  .tile:has(a:focus-visible) { outline: 3px solid var(--color-blue); outline-offset: -3px; }
  .pipes { display: none; }

  @media (min-width: 640px) {
    .tiles { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-inline: 0; padding: 0; overflow: visible; }
    .tile { width: auto; }
    .tile:has(a:focus-visible) { outline-offset: 2px; }
  }
  /* Desktop: the composed 2 x 2 cluster joined by the pipeline, second column set lower. */
  @media (min-width: 1024px) {
    .pipes { display: block; }
    .cluster { padding-bottom: 2.5rem; }
    .tiles { grid-template-columns: repeat(2, 1fr); gap: 1.5rem; }
    .tile:nth-child(even) { top: 2.5rem; }
    .tile :global(img) { padding: 1rem; }
    .tag { padding: 0.625rem 1rem 0.875rem; }
  }
</style>
