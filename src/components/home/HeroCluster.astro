---
/**
 * Hero product cluster (SPEC §3): four real product cut-outs on tiles, joined by a thin pipeline.
 * Images come from the old site's product photos. The first tile is the LCP image.
 */
import { Image } from 'astro:assets';
import pneumaticBall from '../../assets/products/pneumatic-actuated-ball-valve.png';
import globeControl from '../../assets/products/pneumatic-globe-control-valve.png';
import electricBall from '../../assets/products/electric-actuated-ball-valve.png';
/** Background cleaned to a transparent cut-out from the partner photo electromagnetic-flow-meter.jpg (the product page keeps the original). */
import flowMeter from '../../assets/products/electromagnetic-flow-meter-hero.webp';

const tiles = [
  {
    code: 'V-01',
    division: 'valves',
    name: 'Pneumatic actuated ball valve',
    href: '/products/pneumatic-actuated-valves/pneumatic-actuated-ball-valve/',
    image: pneumaticBall,
    alt: 'Flanged ball valve fitted with a pneumatic actuator and limit switch box',
  },
  {
    code: 'V-02',
    division: 'valves',
    name: 'Pneumatic globe control valve',
    href: '/products/pneumatic-actuated-valves/pneumatic-globe-control-valve/',
    image: globeControl,
    alt: 'Globe control valve with a diaphragm actuator and positioner',
  },
  {
    code: 'I-01',
    division: 'instruments',
    name: 'Electromagnetic flow meter',
    href: '/products/flow-meters/electromagnetic-flow-meter/',
    image: flowMeter,
    alt: 'Flanged electromagnetic flow meter with a display transmitter',
  },
  {
    code: 'V-03',
    division: 'valves',
    name: 'Electric actuated ball valve',
    href: '/products/electric-actuated-valves/electric-actuated-ball-valve/',
    image: electricBall,
    alt: 'Screwed-end ball valve fitted with an electric actuator and handwheel',
  },
] as const;
---

<div class="cluster">
  <svg class="pipes" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
    <path class="base" d="M-12 22 H25 V74 H75 V30 H106"></path>
    <path class="pipe-flow flow" d="M-12 22 H25 V74 H75 V30 H106"></path>
  </svg>
  <ul class="tiles">
    {tiles.map((tile, i) => (
      <li class="tile" data-division={tile.division}>
        <Image
          src={tile.image}
          alt={tile.alt}
          widths={[200, 320, 440]}
          sizes="(min-width: 1024px) 220px, 42vw"
          width={440}
          loading={i === 0 ? 'eager' : 'lazy'}
          fetchpriority={i === 0 ? 'high' : 'auto'}
        />
        <p class="tag">
          <span class="code">{tile.code}</span>
          <a href={tile.href}>{tile.name}</a>
        </p>
      </li>
    ))}
  </ul>
</div>

<style>
  .cluster { position: relative; }
  .pipes { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .pipes path { fill: none; stroke-width: 2; vector-effect: non-scaling-stroke; }
  .base { stroke: var(--color-cyan); }
  .flow { stroke: var(--color-blue); }

  .tiles { position: relative; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .tile { position: relative; display: flex; flex-direction: column; background: var(--color-white); border: 1px solid var(--color-line); border-top: 4px solid var(--division); border-radius: 2px; transition: transform 0.15s, border-color 0.15s; }
  .tile:hover { transform: translateY(-3px); border-color: #b9c6d3; border-top-color: var(--division); }
  /* Second column sits lower so the cluster reads as composed, not as a table. */
  .tile:nth-child(even) { top: 1.5rem; }
  .tile :global(img) { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; padding: 0.75rem 0.75rem 0; }
  .tag { display: grid; gap: 0.125rem; padding: 0.5rem 0.75rem 0.75rem; }
  .code { color: var(--color-slate); font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; letter-spacing: 0.08em; }
  .tag a { color: var(--color-navy); font-size: 0.875rem; font-weight: 600; line-height: 1.3; text-decoration: none; }
  .tag a::after { content: ''; position: absolute; inset: 0; }
  .tile:hover .tag a { color: var(--color-blue); }
  .tag a:focus-visible { outline: none; }
  .tile:has(a:focus-visible) { outline: 3px solid var(--color-blue); outline-offset: 2px; }
  .cluster { padding-bottom: 1.5rem; }

  @media (min-width: 1024px) {
    .tiles { gap: 1.5rem; }
    .tile:nth-child(even) { top: 2.5rem; }
    .cluster { padding-bottom: 2.5rem; }
    .tile :global(img) { padding: 1rem 1rem 0; }
    .tag { padding: 0.625rem 1rem 0.875rem; }
  }
</style>
