---
/** The ten product categories in their two division groups (SPEC §3.3), closed by the sourcing block. */
import CategoryCard from '../CategoryCard.astro';
import DivisionBadge from '../DivisionBadge.astro';
import SectionHeader from '../SectionHeader.astro';
import SourcingBlock from '../SourcingBlock.astro';
import Icon from '../Icon.astro';
import { categoryBlurbs, productGroups, productsHref } from '../../config/nav';

const descriptions = categoryBlurbs;
---

<section class="categories">
  <div class="container-content section-y">
    <div class="top">
      <SectionHeader
        eyebrow="Products"
        title="Product categories"
        intro="Ten categories across two divisions. Each one is available to your specification."
      />
      <a class="all" href={productsHref}>All products<Icon name="arrow-right" size={20} /></a>
    </div>

    {productGroups.map((group) => (
      <div class="group">
        <h3 class="group-title">
          <DivisionBadge division={group.division} label={group.label} />
        </h3>
        <ul class="grid">
          {group.links.map((link) => (
            <li data-reveal>
              <CategoryCard
                division={group.division}
                title={link.label}
                href={link.href}
                icon={link.icon ?? 'valve'}
                description={descriptions[link.href]}
                headingLevel="h3"
              />
            </li>
          ))}
        </ul>
      </div>
    ))}

    <div class="sourcing"><SourcingBlock headingLevel="h3" /></div>
  </div>
</section>

<style>
  .categories { background: var(--color-paper); border-block: 1px solid var(--color-line); }
  .top { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; }
  .all { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; font-weight: 600; }
  .group { margin-top: 2.5rem; }
  .group-title { padding-bottom: 0.75rem; border-bottom: 1px solid var(--color-line); font-size: inherit; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-top: 1rem; }
  .grid li { display: grid; }
  .grid li:last-child:nth-child(odd) { grid-column: 1 / -1; }
  .sourcing { margin-top: 3rem; }
  .sourcing :global(.sourcing) { background: var(--color-white); }

  /* Two narrow columns on phones: keep the tiles to icon + name. */
  @media (max-width: 639px) {
    .grid :global(.desc) { display: none; }
    .grid :global(.cat) { padding: 1rem 1rem 1.125rem; }
    .grid :global(.title) { font-size: 1rem; }
  }
  @media (min-width: 640px) {
    .grid { grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .grid li:last-child:nth-child(odd) { grid-column: auto; }
  }
  @media (min-width: 1024px) {
    .grid { grid-template-columns: repeat(5, 1fr); }
  }
</style>
