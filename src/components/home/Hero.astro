---
/** Homepage hero (SPEC §3.1): blueprint grid, headline, two CTAs and the product cluster. */
import BlueprintGrid from '../BlueprintGrid.astro';
import HeroCluster from './HeroCluster.astro';
import CallButton from '../contact/CallButton.astro';
import QuoteButton from '../contact/QuoteButton.astro';
import { site } from '../../config/site';
---

<section class="hero">
  <BlueprintGrid />
  <div class="container-content inner">
    <div class="copy">
      <p class="eyebrow kicker">Valves · Automation · Instruments · Repair</p>
      <h1>Industrial Valves, Instruments &amp; Repair — Any Make, Any Model</h1>
      <p class="sub">
        Manufacturer, supplier and repair partner from Derabassi, serving industries across India.
      </p>
      <div class="actions">
        <QuoteButton />
        <CallButton />
      </div>
      <p class="line">{site.hours.short}</p>
    </div>
    <HeroCluster />
  </div>
</section>

<style>
  .hero { position: relative; border-bottom: 1px solid var(--color-line); }
  .inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr); gap: 2rem; padding-block: 2rem 2.5rem; }
  .kicker { color: var(--color-blue); }
  h1 { margin-top: 1rem; text-wrap: balance; }
  .sub { margin-top: 1.25rem; max-width: 34rem; color: var(--color-slate); font-size: 1.1875rem; line-height: 1.5; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .line { margin-top: 1.25rem; color: var(--color-slate); font-size: var(--text-small); }

  @media (max-width: 479px) {
    .actions :global(.btn) { flex: 1 1 calc(50% - 0.375rem); }
  }
  @media (min-width: 1024px) {
    /* H1 fits three lines at 1366 and the CTAs stay above the fold at 1366x768 and 1536x695. */
    .inner { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); align-items: center; gap: 3.5rem; padding-block: 3rem; }
    h1 { font-size: clamp(2.5rem, 1.5rem + 1.6vw, 3rem); }
    .sub { margin-top: 1rem; }
    .actions { margin-top: 1.75rem; }
  }
</style>
