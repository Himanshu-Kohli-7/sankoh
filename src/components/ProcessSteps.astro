---
/**
 * Numbered process strip joined by a pipeline line (SPEC §3).
 * Defaults to the five workshop repair steps; pass `steps` for anything else.
 * Numbers are used because the content is a real sequence.
 */
import Icon from './Icon.astro';

export interface Step {
  title: string;
  text?: string;
  icon: string;
}

interface Props {
  steps?: Step[];
  headingLevel?: 'h3' | 'h4';
}

const repairSteps: Step[] = [
  { title: 'Receive & inspect', text: 'We receive the unit at our workshop and inspect it.', icon: 'box' },
  { title: 'Strip down & assess', text: 'It is stripped down and each part is assessed.', icon: 'search' },
  { title: 'Repair / replace parts', text: 'Worn or damaged parts are repaired or replaced.', icon: 'wrench' },
  { title: 'Test & calibrate', text: 'The unit is tested before dispatch.', icon: 'pressure' },
  { title: 'Report & dispatch', text: 'You get a report of the work done and the unit is sent back.', icon: 'truck' },
];

const { steps = repairSteps, headingLevel: Tag = 'h3' } = Astro.props;
---

<ol class="steps" style={`--count: ${steps.length}`}>
  {steps.map((step, i) => (
    <li class="step">
      <span class="node"><Icon name={step.icon} size={26} /></span>
      <div class="text">
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <Tag class="title">{step.title}</Tag>
        {step.text && <p>{step.text}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  .steps { display: grid; gap: 0; }
  .step { position: relative; display: grid; grid-template-columns: 3.5rem 1fr; gap: 1rem; padding-bottom: 1.75rem; }
  .step:last-child { padding-bottom: 0; }
  /* The pipe: runs down the left on mobile, across the top on desktop. */
  .step::before { content: ''; position: absolute; left: calc(1.75rem - 1px); top: 3.5rem; bottom: 0; width: 2px; background: var(--color-cyan); }
  .step:last-child::before { display: none; }
  .node { position: relative; display: grid; place-items: center; width: 3.5rem; height: 3.5rem; background: var(--color-white); border: 1.5px solid var(--color-navy); border-radius: 2px; color: var(--color-navy); }
  .num { display: block; color: var(--color-slate); font-family: var(--font-mono); font-size: 0.8125rem; font-weight: 500; letter-spacing: 0.08em; }
  .title { margin-top: 0.125rem; color: var(--color-navy); font-size: 1.125rem; font-weight: 600; line-height: 1.3; }
  p { margin-top: 0.375rem; color: var(--color-slate); font-size: 0.9375rem; line-height: 1.5; }

  @media (min-width: 900px) {
    .steps { grid-template-columns: repeat(var(--count), 1fr); gap: 1.5rem; }
    .step { grid-template-columns: 1fr; gap: 1.25rem; padding-bottom: 0; align-content: start; }
    .step::before { left: 3.5rem; right: -1.5rem; top: calc(1.75rem - 1px); bottom: auto; width: auto; height: 2px; }
  }
</style>
