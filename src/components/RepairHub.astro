---
/**
 * Repair hub (SPEC §5.3): /valve-repair/.
 * Professional through structure, not stock photos (SPEC §3): fact strip, line-icon grid,
 * process steps, repair-vs-replace. The gallery appears only once real photos exist.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import CTABand from './CTABand.astro';
import EnquiryChecklist from './EnquiryChecklist.astro';
import FAQ from './FAQ.astro';
import Icon from './Icon.astro';
import PageHero from './PageHero.astro';
import ProcessSteps from './ProcessSteps.astro';
import RepairServiceCard from './RepairServiceCard.astro';
import SectionHeader from './SectionHeader.astro';
import TrustStats from './TrustStats.astro';
import CallButton from './contact/CallButton.astro';
import WhatsAppButton from './contact/WhatsAppButton.astro';
import QuoteButton from './contact/QuoteButton.astro';
import { site } from '../config/site';
import { groupName, groupThing, repairSteps, repairWhatsApp } from '../config/repair';
import { pageTitle, repairLinks } from '../lib/content';

interface Props {
  hub: CollectionEntry<'repairHubs'>;
}
const { hub } = Astro.props;
const { data } = hub;

/** The quote form reads the slug and selects enquiry type "Repair" (SPEC §6.1 allows only ?product=). */
const quoteSlug = hub.id;
const thing = groupThing[data.group];
/** "Hi, I need valve repair. Photo attached." */
const whatsappText = repairWhatsApp(groupName[data.group]);
const gridName = 'valve';
const label = 'nameplate';
const { warranty } = site.service;

const links = repairLinks(data.services.map((s) => s.href));
const services = data.services.map((s, i) => ({ ...links[i], summary: s.summary }));
const gallery = (await getCollection('repairGallery', (g) => g.data.group === data.group)).sort(
  (a, b) => a.data.order - b.data.order,
);

const breadcrumbs = [{ label: data.title }];
const schema = [
  {
    '@type': 'Service',
    '@id': `${new URL(Astro.url.pathname, site.url).href}#service`,
    name: data.h1,
    serviceType: data.serviceType,
    description: data.metaDescription,
    url: new URL(Astro.url.pathname, site.url).href,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'India' },
  },
];
---

<Base
  title={pageTitle(data.seoTitle)}
  description={data.metaDescription}
  pageName={data.title}
  {whatsappText}
  {breadcrumbs}
  {schema}
>
  <PageHero {breadcrumbs} division="repair" eyebrow="Repair & Service" title={data.h1} lead={data.intro} tone="dark">
    <div class="actions">
      <QuoteButton label="Request repair" product={quoteSlug} tone="dark" />
      <CallButton tone="dark" />
      <WhatsAppButton label="WhatsApp a photo" text={whatsappText} tone="dark" />
    </div>
    <div class="facts" slot="aside"><TrustStats tone="dark" columns={2} /></div>
  </PageHero>

  <section class="container-content section-y" id="what-we-repair">
    <SectionHeader
      eyebrow="What we repair"
      division="repair"
      title={`${services.length} ${gridName} repair services`}
      intro="Find your unit below, or send us a photo if you are not sure what it is."
    />
    <ul class="services">
      {services.map((service) => (
        <li data-reveal>
          <RepairServiceCard title={service.label} href={service.href} icon={service.icon ?? 'wrench'} summary={service.summary} />
        </li>
      ))}
    </ul>
  </section>

  <section class="process">
    <div class="container-content section-y">
      <SectionHeader
        eyebrow="Process"
        division="repair"
        title="How a workshop repair runs"
        intro={`Five steps from your door and back. ${site.service.repairTurnaround}.`}
      />
      <div class="steps"><ProcessSteps steps={repairSteps[data.group]} /></div>
      <ul class="terms">
        <li><Icon name="clock" size={22} />{site.service.repairTurnaround}</li>
        <li><Icon name="pin" size={22} />{site.service.onSiteRepair}</li>
        <li><Icon name="check" size={22} />Warranty: {warranty.repairedValves}</li>
        <li><Icon name="calendar" size={22} />{site.service.supportLine}</li>
      </ul>
    </div>
  </section>

  <section class="container-content section-y" id="repair-or-replace">
    <SectionHeader eyebrow="Repair vs replace" division="repair" title="Repair it or replace it?" intro={data.repairVsReplace.intro} />
    <div class="versus">
      <div class="col" data-kind="repair">
        <h3><Icon name="wrench" size={24} />Repair usually makes sense when</h3>
        <ul>
          {data.repairVsReplace.repair.map((item) => <li><Icon name="check" size={20} />{item}</li>)}
        </ul>
      </div>
      <div class="col" data-kind="replace">
        <h3><Icon name="box" size={24} />Replacing is the better call when</h3>
        <ul>
          {data.repairVsReplace.replace.map((item) => <li><Icon name="arrow-right" size={20} />{item}</li>)}
        </ul>
        {data.repairVsReplace.links.length > 0 && (
          <p class="links">
            {data.repairVsReplace.links.map((l) => <a href={l.href}>{l.label}</a>)}
          </p>
        )}
      </div>
    </div>
  </section>

  <section class="why">
    <div class="container-content section-y">
      <SectionHeader eyebrow="Why Sankoh" division="repair" title="More than a repair bench" />
      <ul class="reasons">
        {data.whySankoh.map((reason) => (
          <li data-reveal>
            <span class="icon"><Icon name={reason.icon} size={26} /></span>
            <h3>{reason.title}</h3>
            <p>{reason.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="container-content section-y">
      <SectionHeader eyebrow="Gallery" division="repair" title="From our workshop" />
      <ul class="gallery">
        {gallery.map((item) => (
          <li>
            <figure>
              <Image src={item.data.image} alt={item.data.alt} widths={[320, 480, 640]} sizes="(min-width: 1024px) 380px, 92vw" loading="lazy" />
              {item.data.caption && <figcaption>{item.data.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="container-content section-y send" id="what-to-send">
    <EnquiryChecklist
      title="What to send us"
      intro={`A photo of the ${thing} and its ${label} is enough to start. Add whatever else you know from this list.`}
      items={data.whatToSend}
    >
      <p class="send-actions">
        <WhatsAppButton label="WhatsApp the details" text={whatsappText} variant="primary" />
        <QuoteButton label="Repair request form" product={quoteSlug} variant="secondary" />
      </p>
    </EnquiryChecklist>
  </section>

  <section class="container-content section-y faq-layout">
    <SectionHeader eyebrow="FAQ" division="repair" title={`${data.title}: common questions`} />
    <FAQ items={data.faqs} schema />
  </section>

  <CTABand
    title="Request repair"
    quoteProduct={quoteSlug}
    quoteLabel="Request repair"
    whatsappLabel="WhatsApp a photo"
    {whatsappText}
  />
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .facts { background: rgb(255 255 255 / 0.04); }

  .services { display: grid; gap: 0.75rem; margin-top: 2.5rem; }
  .services li { display: grid; }

  .process, .why { background: var(--color-paper); border-block: 1px solid var(--color-line); }
  .steps { margin-top: 3rem; }
  .terms { display: grid; gap: 0.5rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .terms li { display: flex; align-items: center; gap: 0.625rem; color: var(--color-navy); font-family: var(--font-mono); font-size: 0.875rem; font-weight: 500; letter-spacing: 0.02em; }
  .terms :global(svg) { flex: none; color: var(--color-blue); }

  .versus { display: grid; gap: 1rem; margin-top: 2.5rem; }
  .col { padding: 1.5rem; border: 1px solid var(--color-line); border-top: 4px solid var(--color-navy); border-radius: 2px; }
  .col[data-kind='repair'] { border-top-color: var(--color-amber); }
  .col h3 { display: flex; align-items: center; gap: 0.625rem; font-size: 1.25rem; }
  .col h3 :global(svg) { flex: none; }
  .col ul { display: grid; gap: 0.875rem; margin-top: 1.25rem; }
  .col li { display: flex; gap: 0.625rem; line-height: 1.5; }
  .col li :global(svg) { flex: none; margin-top: 0.1875rem; color: var(--color-blue); }
  .links { display: flex; flex-wrap: wrap; gap: 0 1.5rem; margin-top: 1.25rem; padding-top: 0.75rem; border-top: 1px solid var(--color-line); }
  .links a { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; }

  .reasons { display: grid; margin-top: 2.5rem; border-top: 1px solid var(--color-line); border-left: 1px solid var(--color-line); background: var(--color-white); }
  .reasons li { padding: 1.5rem; border-right: 1px solid var(--color-line); border-bottom: 1px solid var(--color-line); }
  .icon { display: grid; place-items: center; width: 3rem; height: 3rem; border: 1.5px solid var(--color-navy); border-radius: 2px; color: var(--color-navy); }
  .reasons h3 { margin-top: 1.125rem; font-size: 1.25rem; }
  .reasons p { margin-top: 0.5rem; color: var(--color-slate); font-size: 1rem; line-height: 1.55; }

  .gallery { display: grid; gap: 1rem; margin-top: 2.5rem; }
  .gallery :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--color-line); border-radius: 2px; }
  .gallery figcaption { margin-top: 0.5rem; color: var(--color-slate); font-size: var(--text-small); }

  .send { padding-bottom: 0; }
  .send-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .faq-layout { display: grid; gap: 2rem; }

  @media (max-width: 559px) {
    .actions :global(.btn) { flex: 1 1 100%; }
  }
  @media (min-width: 640px) {
    .services, .versus, .gallery { grid-template-columns: repeat(2, 1fr); }
    .terms { grid-template-columns: repeat(2, auto); justify-content: start; gap: 0.75rem 2.5rem; }
  }
  @media (min-width: 1024px) {
    .services { grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    .services :global(.repair) { flex-direction: column; }
    .versus { gap: 1.5rem; }
    .col { padding: 2rem; }
    .reasons, .gallery { grid-template-columns: repeat(3, 1fr); }
    .reasons li { padding: 2rem; }
    .faq-layout { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 4rem; align-items: start; }
  }
</style>
