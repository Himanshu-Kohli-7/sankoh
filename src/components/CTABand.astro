---
/**
 * Amber call-to-action band (SPEC §1): a heading, three labelled buttons (quote, call, WhatsApp)
 * and one small hours-and-breakdown line. No phone number: the header strip, mobile bar and footer
 * carry it. On amber the primary button is solid navy, since an amber button would disappear.
 */
import CallButton from './contact/CallButton.astro';
import WhatsAppButton from './contact/WhatsAppButton.astro';
import QuoteButton from './contact/QuoteButton.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  /** Product or service slug to prefill on the quote form. */
  quoteProduct?: string;
  quoteLabel?: string;
  whatsappLabel?: string;
  /** Prefilled WhatsApp message. */
  whatsappText?: string;
  headingLevel?: 'h2' | 'h3';
}
const {
  title = 'Tell us what you need',
  quoteProduct,
  quoteLabel = 'Get a quote',
  whatsappLabel = 'WhatsApp',
  whatsappText = `Hello ${site.name}, I have an enquiry.`,
  headingLevel: Tag = 'h2',
} = Astro.props;
---

<section class="band">
  <div class="container-content inner">
    <Tag class="title">{title}</Tag>
    <div class="actions">
      <div class="buttons">
        <QuoteButton label={quoteLabel} product={quoteProduct} tone="amber" />
        <CallButton tone="amber" />
        <WhatsAppButton label={whatsappLabel} text={whatsappText} tone="amber" />
      </div>
      <p class="hours">{site.hours.short} · {site.service.supportLineShort}</p>
    </div>
  </div>
</section>

<style>
  .band { background: var(--color-amber); color: var(--color-navy); }
  .inner { display: grid; gap: 1.5rem; padding-block: 3rem; }
  .title { font-size: var(--text-h2); text-wrap: balance; }
  .actions { display: grid; gap: 0.875rem; }
  .buttons { display: flex; flex-wrap: wrap; gap: 0.75rem; }
  .hours { font-size: 0.9375rem; }
  .band :global(:focus-visible) { outline-color: var(--color-navy); }

  @media (max-width: 479px) {
    .buttons :global(.btn) { flex: 1 1 100%; }
  }
  @media (min-width: 900px) {
    .inner { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 3rem; padding-block: 3.5rem; }
  }
</style>
