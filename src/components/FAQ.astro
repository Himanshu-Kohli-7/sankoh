---
/**
 * FAQs as native <details> (works without JS, SPEC §1).
 * `schema` adds FAQPage JSON-LD — only use it where the FAQs are visible on the page.
 */
import Icon from './Icon.astro';

export interface FaqItem {
  question: string;
  /** Plain text answer. */
  answer: string;
}

interface Props {
  items: FaqItem[];
  schema?: boolean;
}
const { items, schema = false } = Astro.props;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
}).replace(/</g, '\\u003c');
---

<div class="faq">
  {items.map((item) => (
    <details>
      <summary>
        <span>{item.question}</span>
        <Icon name="plus" size={20} />
      </summary>
      <p>{item.answer}</p>
    </details>
  ))}
</div>
{schema && items.length > 0 && <script type="application/ld+json" is:inline set:html={jsonLd} />}

<style>
  .faq { max-width: 50rem; border-top: 1px solid var(--color-line); }
  details { border-bottom: 1px solid var(--color-line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3.5rem; padding-block: 0.875rem; color: var(--color-navy); font-size: 1.125rem; font-weight: 600; line-height: 1.35; cursor: pointer; list-style: none; }
  summary::-webkit-details-marker { display: none; }
  summary :global(svg) { flex: none; color: var(--color-blue); transition: transform 0.2s; }
  details[open] summary :global(svg) { transform: rotate(45deg); }
  summary:hover { color: var(--color-blue); }
  p { max-width: 44rem; padding-bottom: 1.25rem; color: var(--color-slate); }
</style>
