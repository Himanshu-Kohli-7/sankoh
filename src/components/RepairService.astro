---
/**
 * Repair service page (SPEC §5.4), shared by /valve-repair/<service>/ and the single /vfd-repair/ page.
 * Company facts come from site.ts only (CLAUDE.md §4): turnaround, on-site repair, warranty, support line.
 * The process is described in general terms: no test procedure, pressures, spares or certificates.
 * No photos: line-art process steps instead; the gallery appears only once real photos exist.
 */
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import CTABand from './CTABand.astro';
import EnquiryChecklist from './EnquiryChecklist.astro';
import FAQ, { type FaqItem } from './FAQ.astro';
import Icon from './Icon.astro';
import PageHero from './PageHero.astro';
import ProcessSteps from './ProcessSteps.astro';
import ProductCard from './ProductCard.astro';
import RepairServiceCard from './RepairServiceCard.astro';
import SectionHeader from './SectionHeader.astro';
import TrustStats from './TrustStats.astro';
import CallButton from './contact/CallButton.astro';
import WhatsAppButton from './contact/WhatsAppButton.astro';
import QuoteButton from './contact/QuoteButton.astro';
import { site } from '../config/site';
import { repairGroups } from '../config/nav';
import { groupThing, repairSteps, repairWhatsApp } from '../config/repair';
import { categoryInfo, pageTitle, productLink, productsById } from '../lib/content';

interface Props {
  service: CollectionEntry<'repairServices'>;
}
const { service } = Astro.props;
const { data } = service;
const { Content } = await render(service);

/** `valve/ball-valve-repair` → `ball-valve-repair`. Also the quote form slug (SPEC §6.1 allows only ?product=). */
const slug = service.id.split('/').pop()!;
const navGroup = repairGroups.find((g) => g.key === `${data.group}-repair`)!;
/** A group with no sub-pages (VFD repair) is this page itself: no hub above it and no siblings. */
const standalone = navGroup.links.length === 0;
const href = standalone ? navGroup.href : `${navGroup.href}${slug}/`;
const index = navGroup.links.findIndex((l) => l.href === href);
if (!standalone && index < 0) throw new Error(`${service.id}: "${href}" is not listed in config/nav.ts`);
const siblings = navGroup.links.filter((l) => l.href !== href);

/** Two-way links: every product listed here must list this page in its relatedRepair. */
const related = await productsById(data.relatedProducts);
if (related.length !== data.relatedProducts.length) throw new Error(`${service.id}: unknown id in relatedProducts`);
for (const product of related) {
  if (!product.data.relatedRepair.includes(href)) {
    throw new Error(`${service.id}: ${product.id} is in relatedProducts but does not list ${href} in its relatedRepair`);
  }
}

const gallery = (await getCollection('repairGallery', (g) => g.data.group === data.group)).sort(
  (a, b) => a.data.order - b.data.order,
);

/** What the customer photographs. */
const thing = groupThing[data.group];
const label = data.group === 'valve' ? 'nameplate' : 'rating label';
/** Warranty wording comes from site.ts only. Hidden where the term is not confirmed for this service. */
const warranty = data.warranty
  ? data.group === 'valve' ? site.service.warranty.repairedValves : site.service.warranty.repairedVfds
  : undefined;
/** The same confirmed fact on every repair page, so it is added here rather than written into each file. */
const faqs: FaqItem[] = warranty
  ? [...data.faqs, { question: 'Is there a warranty on the repair?', answer: `Yes. The warranty is ${warranty}.` }]
  : data.faqs;
/** "Hi, I need ball valve repair. Photo attached." */
const whatsappText = repairWhatsApp(data.title);
const eyebrow = standalone ? 'Repair & Service' : `${navGroup.label} / ${String(index + 1).padStart(2, '0')}`;
const anyMake = data.brandsNote ?? 'Any make and model';

const breadcrumbs = standalone ? [{ label: data.title }] : [{ label: navGroup.label, href: navGroup.href }, { label: data.title }];
/** Service only: no offers, price, ratings or reviews. */
const schema = [
  {
    '@type': 'Service',
    '@id': `${new URL(Astro.url.pathname, site.url).href}#service`,
    name: data.title,
    serviceType: data.serviceType,
    description: data.metaDescription,
    url: new URL(Astro.url.pathname, site.url).href,
    provider: { '@id': `${site.url}/#organization` },
    areaServed: { '@type': 'Country', name: 'India' },
  },
];
---

<Base
  title={pageTitle(data.seoTitle)}
  description={data.metaDescription}
  pageName={data.title}
  {whatsappText}
  {breadcrumbs}
  {schema}
>
  <PageHero {breadcrumbs} division="repair" {eyebrow} title={data.title} lead={data.summary} tone="dark">
    <div class="actions">
      <QuoteButton label="Request repair" product={slug} tone="dark" />
      <CallButton tone="dark" />
      <WhatsAppButton label="WhatsApp a photo" text={whatsappText} tone="dark" />
    </div>
    <div class="facts" slot="aside"><TrustStats tone="dark" columns={2} /></div>
  </PageHero>

  <div class="container-content body">
    <div class="main">
      <section class="block" id="what-we-repair">
        <h2>What we repair</h2>
        <ul class="ticks">
          {data.whatWeRepair.map((item) => <li><Icon name="check" size={20} />{item}</li>)}
        </ul>
        <p class="make"><span class="eyebrow">Makes</span>{anyMake}</p>
      </section>

      <section class="block" id="common-faults">
        <h2>Common faults we see</h2>
        <ul class="faults">
          {data.commonFaults.map((fault) => (
            <li>
              <h3>{fault.title}</h3>
              <p>{fault.text}</p>
            </li>
          ))}
        </ul>
      </section>

      <section class="block" id="how-it-works">
        <h2>How the repair works</h2>
        <div class="prose"><Content /></div>
      </section>
    </div>

    <aside class="enquire" aria-label="Request this repair">
      <p class="eyebrow">Request repair</p>
      <p class="enquire-title">{data.title}</p>
      <QuoteButton label="Request repair" product={slug} />
      <CallButton />
      <WhatsAppButton label="WhatsApp a photo" text={whatsappText} />
      <p class="enquire-note">{site.service.supportLine}.</p>
    </aside>
  </div>

  <section class="process">
    <div class="container-content section-y">
      <SectionHeader eyebrow="Process" division="repair" title="From inspection to dispatch" />
      <div class="steps"><ProcessSteps steps={repairSteps[data.group]} /></div>
      <ul class="terms">
        <li><Icon name="clock" size={22} />{site.service.repairTurnaround}</li>
        <li><Icon name="pin" size={22} />{site.service.onSiteRepair}</li>
        {warranty && <li><Icon name="check" size={22} />Warranty: {warranty}</li>}
        <li><Icon name="calendar" size={22} />{site.service.supportLine}</li>
      </ul>
    </div>
  </section>

  <section class="container-content section-y send" id="what-to-send">
    <EnquiryChecklist
      title="What to send us"
      intro={`Start with a photo of the ${thing} and its ${label}. The rest helps us get it right first time.`}
      items={data.whatToSend}
    >
      <p class="send-actions">
        <WhatsAppButton label="WhatsApp the details" text={whatsappText} variant="primary" />
        <QuoteButton label="Repair request form" product={slug} variant="secondary" />
      </p>
    </EnquiryChecklist>
  </section>

  <section class="container-content section-y faq-layout">
    <SectionHeader eyebrow="FAQ" division="repair" title={`${data.title}: common questions`} />
    <FAQ items={faqs} schema />
  </section>

  <section class="related">
    <div class="container-content section-y">
      {related.length > 0 && (
        <div class="related-products">
          <h2>Products this repair covers</h2>
          <ul class="grid">
            {related.map((item) => (
              <li>
                <ProductCard
                  division={categoryInfo(item.data.category).division}
                  title={item.data.title}
                  href={productLink(item)}
                  summary={item.data.summary}
                  image={item.data.images[0]?.src}
                  imageAlt={item.data.images[0]?.alt}
                  headingLevel="h3"
                />
              </li>
            ))}
          </ul>
        </div>
      )}
      <div class:list={['siblings', related.length > 0 && 'spaced']}>
        <h2>{standalone ? 'Other repair services' : `Other ${navGroup.label.toLowerCase()} services`}</h2>
        <ul class="repairs">
          {(standalone ? repairGroups.filter((g) => g !== navGroup).flatMap((g) => g.links) : siblings).map((link) => (
            <li><RepairServiceCard title={link.label} href={link.href} icon={link.icon ?? 'wrench'} /></li>
          ))}
        </ul>
        <p class="hubs">
          {!standalone && <a href={navGroup.href}>All {navGroup.label.toLowerCase()} services<Icon name="arrow-right" size={20} /></a>}
          {repairGroups.filter((g) => g !== navGroup).map((g) => (
            <a href={g.href}>{g.links.length ? `All ${g.label.toLowerCase()} services` : g.label}<Icon name="arrow-right" size={20} /></a>
          ))}
        </p>
      </div>
    </div>
  </section>

  {gallery.length > 0 && (
    <section class="container-content section-y">
      <SectionHeader eyebrow="Gallery" division="repair" title="From our workshop" />
      <ul class="gallery">
        {gallery.map((item) => (
          <li>
            <figure>
              <Image src={item.data.image} alt={item.data.alt} widths={[320, 480, 640]} sizes="(min-width: 1024px) 380px, 92vw" loading="lazy" />
              {item.data.caption && <figcaption>{item.data.caption}</figcaption>}
            </figure>
          </li>
        ))}
      </ul>
    </section>
  )}

  <CTABand
    title="Request repair"
    quoteProduct={slug}
    quoteLabel="Request repair"
    whatsappLabel="WhatsApp a photo"
    {whatsappText}
  />
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .facts { background: rgb(255 255 255 / 0.04); }

  .body { display: grid; gap: 3rem; padding-block: 3rem var(--section-y); }
  .main { min-width: 0; }
  .block + .block { margin-top: 3rem; padding-top: 3rem; border-top: 1px solid var(--color-line); }
  .block > h2 { margin-bottom: 1.25rem; }

  .ticks { display: grid; gap: 0.625rem; }
  .ticks li { display: flex; gap: 0.625rem; line-height: 1.45; }
  .ticks :global(svg) { flex: none; margin-top: 0.125rem; color: var(--color-blue); }
  .make { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.875rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px dashed var(--color-line); color: var(--color-navy); font-weight: 600; }
  .make .eyebrow { color: var(--color-slate); }

  .faults { display: grid; gap: 0.75rem; }
  .faults li { padding: 1.125rem 1.25rem; border: 1px solid var(--color-line); border-left: 4px solid var(--color-amber); border-radius: 2px; background: var(--color-white); }
  .faults h3 { font-size: 1.0625rem; line-height: 1.3; }
  .faults p { margin-top: 0.375rem; color: var(--color-slate); font-size: 0.9375rem; line-height: 1.5; }

  /* Desktop side panel; phones have the action bar instead. */
  .enquire { display: none; }

  .process { background: var(--color-paper); border-block: 1px solid var(--color-line); }
  .steps { margin-top: 3rem; }
  .terms { display: grid; gap: 0.5rem; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--color-line); }
  .terms li { display: flex; align-items: center; gap: 0.625rem; color: var(--color-navy); font-family: var(--font-mono); font-size: 0.875rem; font-weight: 500; letter-spacing: 0.02em; }
  .terms :global(svg) { flex: none; color: var(--color-blue); }

  .send { padding-bottom: 0; }
  .send-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.5rem; }
  .faq-layout { display: grid; gap: 2rem; }

  .related { background: var(--color-paper); border-top: 1px solid var(--color-line); }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-top: 1.5rem; }
  .grid li { display: grid; }
  .spaced { margin-top: 3.5rem; }
  .repairs { display: grid; gap: 0.75rem; margin-top: 1.5rem; }
  .repairs li { display: grid; }
  .hubs { display: flex; flex-wrap: wrap; gap: 0 1.5rem; margin-top: 1.25rem; }
  .hubs a { display: inline-flex; align-items: center; gap: 0.375rem; min-height: 2.75rem; font-weight: 600; }

  .gallery { display: grid; gap: 1rem; margin-top: 2.5rem; }
  .gallery :global(img) { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border: 1px solid var(--color-line); border-radius: 2px; }
  .gallery figcaption { margin-top: 0.5rem; color: var(--color-slate); font-size: var(--text-small); }

  @media (max-width: 559px) {
    .actions :global(.btn) { flex: 1 1 calc(50% - 0.375rem); }
    .actions :global(.btn:first-child) { flex-basis: 100%; }
  }
  @media (max-width: 639px) {
    .grid :global(.summary) { display: none; }
    .grid :global(.title) { font-size: 1rem; }
  }
  @media (min-width: 640px) {
    .faults, .repairs, .gallery { grid-template-columns: repeat(2, 1fr); }
    .grid { gap: 1rem; }
    .terms { grid-template-columns: repeat(2, auto); justify-content: start; gap: 0.75rem 2.5rem; }
  }
  @media (min-width: 1024px) {
    .body { grid-template-columns: minmax(0, 1fr) 20rem; gap: 4rem; padding-top: 4rem; }
    .enquire { position: sticky; top: 6.5rem; display: grid; gap: 0.75rem; align-self: start; padding: 1.5rem; background: var(--color-white); border: 1px solid var(--color-line); border-top: 4px solid var(--color-amber); border-radius: 2px; }
    .enquire .eyebrow { color: var(--color-slate); }
    .enquire-title { color: var(--color-navy); font-size: 1.25rem; font-weight: 600; line-height: 1.25; }
    .enquire-note { color: var(--color-slate); font-size: var(--text-small); }
    .grid { grid-template-columns: repeat(4, 1fr); }
    .repairs { grid-template-columns: repeat(3, 1fr); }
    .gallery { grid-template-columns: repeat(3, 1fr); }
    .faq-layout { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 4rem; align-items: start; }
  }
</style>
