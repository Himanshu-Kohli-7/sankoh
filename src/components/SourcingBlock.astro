---
/**
 * "Can't find what you need? We'll source it" — closes every category page (CLAUDE.md §3).
 * The dashed outline reads like a part still to be drawn in.
 */
import Button from './Button.astro';
import { quoteHref } from '../config/site';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel: Tag = 'h2' } = Astro.props;
---

<aside class="sourcing">
  <div class="copy">
    <Tag class="title">Can’t find what you need? We’ll source it.</Tag>
    <p>
      We trade through a vendor network and can source products that aren’t listed on this site, to your specification.
      Tell us what you’re looking for.
    </p>
  </div>
  <div class="actions">
    <Button href={quoteHref()}>Ask us to source it</Button>
    <a class="more" href="/services/product-sourcing/">How product sourcing works</a>
  </div>
</aside>

<style>
  .sourcing { display: grid; gap: 1.5rem; padding: 1.75rem 1.5rem; background: var(--color-paper); border: 1.5px dashed var(--color-blue); border-radius: 2px; }
  .title { font-size: var(--text-h3); }
  p { margin-top: 0.625rem; max-width: 40rem; color: var(--color-slate); }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.5rem; }
  .more { display: inline-flex; align-items: center; min-height: 2.75rem; font-weight: 600; }

  @media (min-width: 900px) {
    .sourcing { grid-template-columns: 1fr auto; align-items: center; gap: 3rem; padding: 2.25rem 2.5rem; }
    .actions { flex-direction: column; align-items: flex-start; }
  }
</style>
