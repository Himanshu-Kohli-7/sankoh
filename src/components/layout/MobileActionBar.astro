---
/**
 * Fixed bottom bar at ≤768px (SPEC §1): Call · WhatsApp · Quote.
 * The page's matching bottom padding is --action-bar-h in global.css.
 */
import Icon from '../Icon.astro';
import { site, telHref, waHref, quoteHref } from '../../config/site';

interface Props {
  pageName: string;
  quoteProduct?: string;
}
const { pageName, quoteProduct } = Astro.props;
const message = `Hello ${site.name}, I have an enquiry about: ${pageName}`;
---

<nav class="actionbar" aria-label="Quick contact">
  <a href={telHref()} data-event="click_call"><Icon name="phone" size={22} />Call</a>
  <a href={waHref(message)} data-event="click_whatsapp"><Icon name="whatsapp" size={22} />WhatsApp</a>
  <a class="quote" href={quoteHref(quoteProduct)}><Icon name="quote" size={22} />Quote</a>
</nav>

<style>
  .actionbar { display: none; }
  @media (max-width: 768px) {
    .actionbar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 50;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: var(--color-white);
      border-top: 1px solid var(--color-line);
      box-shadow: 0 -8px 24px -16px rgb(16 42 76 / 0.35);
    }
    a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      height: 56px;
      color: var(--color-navy);
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
    }
    a + a { border-left: 1px solid var(--color-line); }
    a :global(svg) { color: var(--color-blue); }
    .quote { background: var(--color-amber); border-left-color: var(--color-amber); }
    .quote :global(svg) { color: var(--color-navy); }
    a:focus-visible { outline-offset: -3px; }
  }
</style>
