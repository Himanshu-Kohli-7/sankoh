---
/**
 * Fixed bottom bar at ≤768px (SPEC §1): two labelled buttons, Call and WhatsApp, no digits.
 * The number is in each link's accessible name. From 769px the header strip shows the number
 * instead, so at every width one Call route is visible.
 * The page's matching bottom padding is --action-bar-h in global.css.
 */
import Icon from '../Icon.astro';
import { site, telHref, waHref, callAria, whatsappAria } from '../../config/site';

interface Props {
  pageName: string;
  /** Overrides the default message. */
  whatsappText?: string;
}
const { pageName, whatsappText } = Astro.props;
const message = whatsappText ?? `Hello ${site.name}, I have an enquiry about: ${pageName}`;
---

<nav class="actionbar" aria-label="Quick contact">
  <a href={telHref()} data-event="click_call" aria-label={callAria('Call')}><Icon name="phone" size={22} />Call</a>
  <a class="wa" href={waHref(message)} data-event="click_whatsapp" aria-label={whatsappAria('WhatsApp')}><Icon name="whatsapp" size={22} />WhatsApp</a>
</nav>

<style>
  .actionbar { display: none; }
  @media (max-width: 768px) {
    .actionbar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 50;
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: var(--color-white);
      border-top: 1px solid var(--color-line);
      box-shadow: 0 -8px 24px -16px rgb(16 42 76 / 0.35);
    }
    a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      height: 56px;
      color: var(--color-navy);
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
    }
    a:first-child { background: var(--color-amber); }
    a:first-child :global(svg) { color: var(--color-navy); }
    .wa :global(svg) { color: var(--color-blue); }
    a:focus-visible { outline-offset: -3px; }
  }
</style>
