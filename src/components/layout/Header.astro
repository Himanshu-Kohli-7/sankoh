---
/**
 * Site header (SPEC §1): navy utility strip (desktop), sticky white bar that compacts on scroll,
 * Products mega-menu drawn as a pipe manifold, and the mobile menu island.
 * Everything is real links in the HTML; JS only adds the chevron toggle and compact state.
 */
import Icon from '../Icon.astro';
import MobileMenu from './MobileMenu';
import { site, telHref, quoteHref } from '../../config/site';
import { productGroups, primaryLinks, productsHref, selectorHref } from '../../config/nav';
import { catalogue } from '../../config/catalogue';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
const secondPhone = site.phones[1];
---

<div class="util">
  <div class="container-content util-inner">
    <p class="util-group">
      <span class="util-item"><Icon name="pin" size={16} />{site.address.locationWording}</span>
      <span class="util-item">{site.service.availability}</span>
    </p>
    <p class="util-group">
      <a class="util-item" href={`mailto:${site.email.primary}`}><Icon name="mail" size={16} />{site.email.primary}</a>
      <a class="util-item util-mono" href={telHref(secondPhone)}>{secondPhone.display}</a>
    </p>
  </div>
</div>
<div class="sentinel" data-header-sentinel aria-hidden="true"></div>

<header class="site-header" data-site-header>
  <div class="bar">
    <div class="container-content bar-inner">
      <a class="logo" href="/" aria-label={`${site.name}, home`}>
        <picture>
          <source media="(max-width: 359px)" srcset="/brand/sankoh-icon.svg" width="40" height="40" />
          <img src="/brand/sankoh-logo-full.svg" width="187" height="40" alt={site.name} />
        </picture>
      </a>

      <nav class="primary" aria-label="Main">
        <ul class="primary-list">
          <li class="has-mega" data-mega>
            <a class="nav-link" href={productsHref} aria-current={isCurrent(productsHref) ? 'page' : undefined}>Products</a>
            <button class="mega-toggle" type="button" aria-expanded="false" aria-controls="mega-products" aria-label="Show product categories">
              <Icon name="chevron-down" size={16} />
            </button>

            <div class="mega" id="mega-products">
              <div class="container-content mega-grid">
                <svg class="trunk" width="100%" height="2" aria-hidden="true">
                  <line x1="0" y1="1" x2="100%" y2="1" stroke="var(--color-cyan)" stroke-width="2"></line>
                  <line class="pipe-flow" x1="0" y1="1" x2="100%" y2="1" stroke="var(--color-blue)" stroke-width="2"></line>
                </svg>

                {productGroups.map((group) => (
                  <div class="branch" data-division={group.division}>
                    <p class="branch-head">
                      <a href={group.href}>{group.label}</a>
                    </p>
                    <ul>
                      {group.links.map((link) => (
                        <li>
                          <a class="branch-link" href={link.href}>
                            <svg class="node" viewBox="0 0 12 18" width="12" height="18" aria-hidden="true">
                              <path d="M1 1h10L6 9 1 1z M1 17h10L6 9l-5 8z"></path>
                            </svg>
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}

                <div class="rail">
                  <a class="rail-link" href={productsHref}>All products <Icon name="arrow-right" size={18} /></a>
                  <a class="rail-link" href={selectorHref}>Product selector <Icon name="arrow-right" size={18} /></a>
                  {catalogue.available && (
                    <a class="rail-link" href={catalogue.href} download>Catalogue (PDF) <Icon name="download" size={18} /></a>
                  )}
                  <p class="rail-note">
                    Can’t find what you need? <a href="/services/product-sourcing/">We’ll source it</a> to your specification.
                  </p>
                </div>
              </div>
            </div>
          </li>
          {primaryLinks.map((link) => (
            <li>
              <a class="nav-link" href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="actions">
        <a class="phone" href={telHref()} data-event="click_call">
          <Icon name="phone" size={18} /><span>{site.primaryPhone.display}</span>
        </a>
        <a class="btn btn-primary btn-sm quote" href={quoteHref()}>Get a Quote</a>
        <div class="menu-slot">
          <MobileMenu client:load currentPath={path} catalogueHref={catalogue.available ? catalogue.href : null} />
        </div>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const header = document.querySelector('[data-site-header]');
    const sentinel = document.querySelector('[data-header-sentinel]');
    if (!header) return;
    if (sentinel && 'IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => header.toggleAttribute('data-compact', !entry.isIntersecting)).observe(sentinel);
    }
    const item = header.querySelector('[data-mega]');
    const toggle = item && item.querySelector('.mega-toggle');
    if (!toggle) return;
    const set = (open) => {
      item.toggleAttribute('data-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Hide product categories' : 'Show product categories');
    };
    toggle.addEventListener('click', () => set(!item.hasAttribute('data-open')));
    item.addEventListener('focusout', (e) => {
      if (!item.contains(e.relatedTarget)) set(false);
    });
    document.addEventListener('click', (e) => {
      if (!item.contains(e.target)) set(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && item.hasAttribute('data-open')) {
        set(false);
        toggle.focus();
      }
    });
  })();
</script>

<style>
  /* ---------- Utility strip (desktop only) ---------- */
  .util { display: none; background: var(--color-navy); color: rgb(255 255 255 / 0.86); font-size: 0.8125rem; }
  .util-inner { display: flex; justify-content: space-between; align-items: center; height: 2.25rem; }
  .util-group { display: flex; align-items: center; }
  .util-item { display: inline-flex; align-items: center; gap: 0.375rem; color: inherit; text-decoration: none; }
  .util-item + .util-item { margin-left: 1rem; padding-left: 1rem; border-left: 1px solid rgb(255 255 255 / 0.25); }
  .util-item :global(svg) { color: var(--color-cyan); }
  a.util-item:hover { color: var(--color-white); text-decoration: underline; }
  .util-mono { font-family: var(--font-mono); font-weight: 500; }

  .sentinel { position: absolute; top: 0; left: 0; width: 1px; height: 7.5rem; pointer-events: none; }

  /* ---------- Sticky bar ----------
     The header keeps a constant height in the flow; only the visible bar shrinks,
     so compacting never shifts the page. */
  .site-header { position: sticky; top: 0; z-index: 60; height: var(--header-h); pointer-events: none; --header-h: 3.75rem; --bar-h: 3.75rem; }
  .bar { position: relative; height: var(--bar-h); background: var(--color-white); border-bottom: 1px solid var(--color-line); pointer-events: auto; transition: height 0.2s; }
  .bar-inner { display: flex; align-items: center; gap: 1.5rem; height: 100%; }

  .logo { display: flex; align-items: center; flex: none; min-height: 2.75rem; }
  .logo img { display: block; height: 2.125rem; width: auto; transition: height 0.2s; }

  .primary { display: none; height: 100%; margin-inline: auto; }
  .primary-list { display: flex; align-items: stretch; gap: 1.5rem; height: 100%; }
  .primary-list > li { display: flex; align-items: center; }
  .nav-link { position: relative; display: flex; align-items: center; height: 100%; color: var(--color-ink); font-size: 0.9375rem; font-weight: 600; text-decoration: none; white-space: nowrap; }
  .nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: -1px; height: 3px; background: var(--color-navy); transform: scaleX(0); transform-origin: left; transition: transform 0.2s; }
  .nav-link:hover::after, .nav-link[aria-current='page']::after, .has-mega:hover > .nav-link::after, .has-mega[data-open] > .nav-link::after { transform: scaleX(1); }
  .nav-link:hover { color: var(--color-navy); }

  .mega-toggle { display: grid; place-items: center; width: 1.75rem; height: 2.75rem; margin-left: 0.125rem; color: var(--color-slate); cursor: pointer; }
  .mega-toggle :global(svg) { transition: transform 0.2s; }
  .has-mega:hover .mega-toggle :global(svg), .has-mega[data-open] .mega-toggle :global(svg) { transform: rotate(180deg); }

  .actions { display: flex; align-items: center; gap: 1rem; margin-left: auto; }
  .primary + .actions { flex: none; }
  .phone { display: none; align-items: center; gap: 0.5rem; min-height: 2.75rem; color: var(--color-navy); font-family: var(--font-mono); font-weight: 500; font-size: 0.9375rem; text-decoration: none; white-space: nowrap; }
  .phone :global(svg) { color: var(--color-blue); }
  .phone:hover { text-decoration: underline; }
  .quote { display: none; }

  /* ---------- Mega-menu: a manifold ---------- */
  .mega { position: absolute; left: 0; right: 0; top: 100%; background: var(--color-white); border-bottom: 1px solid var(--color-line); box-shadow: 0 24px 40px -24px rgb(16 42 76 / 0.28); visibility: hidden; opacity: 0; transition: opacity 0.15s, visibility 0s 0.15s; }
  .has-mega:hover .mega, .has-mega[data-open] .mega { visibility: visible; opacity: 1; transition-delay: 0s; }
  .mega-grid { display: grid; grid-template-columns: 1fr 1fr 18.5rem; column-gap: 3rem; padding-top: 2rem; padding-bottom: 2.5rem; }
  .trunk { grid-column: 1 / 3; display: block; }
  .rail { grid-column: 3; grid-row: 1 / 3; }

  /* Each division drops off the trunk as a branch; categories sit on it at valve nodes. */
  .branch { padding-left: 6px; }
  .branch-head, .branch li { position: relative; padding-left: 1.75rem; }
  .branch-head::before, .branch li::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--division); }
  .branch li:last-child::before { bottom: 50%; }
  .branch-head { padding-top: 1.25rem; padding-bottom: 0.5rem; }
  .branch-head a { color: var(--division-text); font-size: 1.125rem; font-weight: 600; text-decoration: none; }
  .branch-head a:hover { text-decoration: underline; }
  .branch-link { display: flex; align-items: center; min-height: 2.75rem; color: var(--color-ink); font-size: 1rem; text-decoration: none; }
  .branch-link:hover { color: var(--color-blue); }
  .node { position: absolute; left: -5px; top: 50%; transform: translateY(-50%); fill: var(--color-white); stroke: var(--division); stroke-width: 1.5; stroke-linejoin: round; transition: fill 0.15s; }
  .branch-link:hover .node, .branch-link:focus-visible .node { fill: var(--division); }

  .rail { align-self: start; padding: 1.25rem 1.5rem 1.5rem; background: var(--color-paper); border: 1px solid var(--color-line); border-radius: 2px; }
  .rail-link { display: flex; align-items: center; justify-content: space-between; min-height: 2.75rem; border-bottom: 1px solid var(--color-line); color: var(--color-navy); font-weight: 600; text-decoration: none; }
  .rail-link:hover { color: var(--color-blue); }
  .rail-note { margin-top: 1rem; color: var(--color-slate); font-size: 0.9375rem; line-height: 1.5; }

  /* ---------- Breakpoints ---------- */
  @media (min-width: 769px) {
    .quote { display: inline-flex; }
  }
  @media (min-width: 1120px) {
    .util { display: block; }
    .site-header { --header-h: 4.5rem; --bar-h: 4.5rem; }
    .site-header[data-compact] { --bar-h: 3.5rem; }
    .logo img { height: 2.5rem; }
    .site-header[data-compact] .logo img { height: 2rem; }
    .primary { display: block; }
    .menu-slot { display: none; }
  }
  @media (min-width: 1280px) {
    .primary-list { gap: 1.75rem; }
    .phone { display: inline-flex; }
  }
</style>
