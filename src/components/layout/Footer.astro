---
/**
 * Footer (SPEC §1): navy, four link columns, and the company details set out
 * like the title block of an engineering drawing.
 */
import Icon from '../Icon.astro';
import BlueprintGrid from '../BlueprintGrid.astro';
import { site, telHref, waHref, mapsHref } from '../../config/site';
import { productGroups, repairGroups, serviceLinks, companyLinks } from '../../config/nav';
import { catalogue } from '../../config/catalogue';

const [valves, instruments] = productGroups;
const year = new Date().getFullYear();
const { address } = site;
---

<footer class="site-footer">
  <BlueprintGrid tone="dark" fade="none" />
  <div class="container-content inner">
    <div class="intro">
      <a class="logo" href="/" aria-label={`${site.name}, home`}>
        <img src="/brand/sankoh-logo-full.svg" width="206" height="44" alt={site.name} loading="lazy" />
      </a>
      <p class="positioning">{site.positioning}</p>
    </div>

    <nav id="footer-nav" class="columns" aria-label="Footer">
      <div>
        <h2><a href={valves.href}>{valves.label}</a></h2>
        <ul>
          {valves.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2><a href={instruments.href}>{instruments.label}</a></h2>
        <ul>
          {instruments.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Repair & Services</h2>
        <ul>
          {repairGroups.map((g) => <li><a href={g.href}>{g.label}</a></li>)}
          {serviceLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
      <div>
        <h2>Company</h2>
        <ul>
          {companyLinks.slice(0, 3).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
          {catalogue.available && (
            <li><a href={catalogue.href} download data-event="download_catalogue">Catalogue (PDF)</a></li>
          )}
          {companyLinks.slice(3).map((l) => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </nav>

    <dl class="titleblock">
      <div class="cell cell-address">
        <dt>Address</dt>
        <dd>
          <address>
            {address.line1}, {address.line2},<br />
            {address.locality} – {address.postalCode}, {address.district},<br />
            {address.region}, {address.country}
          </address>
          <a class="maplink" href={mapsHref()} target="_blank" rel="noopener">
            <Icon name="pin" size={16} />Open in Google Maps
          </a>
        </dd>
      </div>
      <div class="cell">
        <dt>Phone</dt>
        <dd class="mono">
          {site.phones.map((p) => <a href={telHref(p)} data-event="click_call">{p.display}</a>)}
        </dd>
      </div>
      <div class="cell">
        <dt>WhatsApp</dt>
        <dd class="mono"><a href={waHref()} data-event="click_whatsapp">{site.whatsapp.display}</a></dd>
      </div>
      <div class="cell">
        <dt>Email</dt>
        <dd><a href={`mailto:${site.email.primary}`}>{site.email.primary}</a></dd>
      </div>
      <div class="cell">
        <dt>GSTIN</dt>
        <dd class="mono">{site.gstin}</dd>
      </div>
      <div class="cell cell-service">
        <dt>Office hours</dt>
        <dd>
          {site.hours.display} · {site.hours.closed}<br />
          {site.service.supportLine} · Repairs typically in 2–3 days
        </dd>
      </div>
    </dl>

    <p class="copyright">© {year} {site.name}</p>
  </div>
</footer>

<style>
  .site-footer { position: relative; background: var(--color-navy); color: rgb(255 255 255 / 0.82); font-size: 0.9375rem; }
  .inner { position: relative; padding-block: 3.5rem 2rem; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: var(--color-white); text-decoration: underline; }

  .intro { display: grid; gap: 1.25rem; padding-bottom: 2.5rem; }
  .logo { display: inline-flex; width: fit-content; }
  /* The traced logo is blue and cyan; on navy it is shown in white. */
  .logo img { display: block; height: 2.75rem; width: auto; filter: brightness(0) invert(1); }
  .positioning { max-width: 34rem; color: var(--color-white); font-size: 1.0625rem; line-height: 1.5; }

  .columns { display: grid; grid-template-columns: 1fr; gap: 2rem 1.5rem; padding-block: 2.5rem; border-top: 1px solid rgb(255 255 255 / 0.16); }
  h2 { display: flex; align-items: center; min-height: 2.75rem; color: var(--color-white); font-size: 1rem; font-weight: 600; line-height: 1.3; }
  h2 a { display: flex; align-items: center; min-height: 2.75rem; }
  .columns li a { display: flex; align-items: center; min-height: 2.75rem; padding-block: 0.375rem; line-height: 1.3; }

  /* Title block: bordered cells with mono labels. */
  .titleblock { display: grid; grid-template-columns: 1fr; border: 1px solid rgb(255 255 255 / 0.28); }
  .cell { padding: 0.875rem 1rem 1rem; border-top: 1px solid rgb(255 255 255 / 0.28); }
  .cell:first-child { border-top: 0; }
  dt { margin-bottom: 0.375rem; color: var(--color-cyan); font-family: var(--font-mono); font-size: 0.6875rem; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; }
  dd { color: var(--color-white); line-height: 1.5; overflow-wrap: anywhere; }
  dd a { display: flex; align-items: center; min-height: 2.75rem; width: fit-content; }
  address { font-style: normal; }
  .mono { font-family: var(--font-mono); font-weight: 500; font-size: 0.9375rem; }
  .maplink { gap: 0.375rem; margin-top: 0.25rem; color: rgb(255 255 255 / 0.82); font-size: 0.875rem; text-decoration: underline; text-underline-offset: 3px; }
  .maplink :global(svg) { color: var(--color-cyan); }

  .copyright { padding-top: 1.5rem; font-size: 0.875rem; color: rgb(255 255 255 / 0.7); }

  @media (min-width: 560px) {
    .columns { grid-template-columns: 1fr 1fr; }
    .titleblock { grid-template-columns: 1fr 1fr; }
    .cell-address, .cell-service { grid-column: 1 / -1; }
    .cell { border-left: 1px solid rgb(255 255 255 / 0.28); }
    .cell-address, .cell-service, .cell:nth-child(2), .cell:nth-child(4) { border-left: 0; }
  }
  @media (min-width: 1024px) {
    .intro { grid-template-columns: auto 1fr; align-items: center; gap: 3rem; }
    .columns { grid-template-columns: repeat(4, 1fr); gap: 2rem; }
    .columns li a { min-height: 2.25rem; }
    h2, h2 a { min-height: 2.25rem; }
    dd a { min-height: 2rem; }
    .titleblock { grid-template-columns: 1.7fr 1fr 1fr 1.25fr 1fr; }
    .cell-address { grid-column: 1; grid-row: 1 / 3; }
    .cell-service { grid-column: 2 / -1; }
    .cell { border-top: 0; }
    .cell:nth-child(n) { border-left: 1px solid rgb(255 255 255 / 0.28); }
    .cell-address { border-left: 0 !important; }
    .cell-service { border-top: 1px solid rgb(255 255 255 / 0.28); }
  }
</style>
