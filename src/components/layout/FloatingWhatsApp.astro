---
/** Small floating WhatsApp button, shown above 768px where there is no action bar (SPEC §1). */
import Icon from '../Icon.astro';
import { site, waHref } from '../../config/site';

interface Props {
  pageName: string;
}
const { pageName } = Astro.props;
const message = `Hello ${site.name}, I have an enquiry about: ${pageName}`;
---

<a class="wa" href={waHref(message)} target="_blank" rel="noopener" data-event="click_whatsapp" aria-label="Chat with us on WhatsApp">
  <Icon name="whatsapp" size={26} />
</a>

<style>
  .wa { display: none; }
  @media (min-width: 769px) {
    .wa {
      position: fixed;
      right: 1.5rem;
      bottom: 1.5rem;
      z-index: 50;
      display: grid;
      place-items: center;
      width: 3.25rem;
      height: 3.25rem;
      border-radius: 50%;
      background: var(--color-navy);
      color: var(--color-white);
      box-shadow: 0 0 0 2px var(--color-white), 0 0 0 4px var(--color-cyan);
      transition: background-color 0.15s;
    }
    .wa:hover { background: var(--color-blue); }
  }
</style>
