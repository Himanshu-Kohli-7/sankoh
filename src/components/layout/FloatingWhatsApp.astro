---
/**
 * Small floating WhatsApp icon, shown above 768px where there is no action bar (SPEC §1).
 * Icon only; its accessible name is "WhatsApp Sankoh on +91 …".
 */
import WhatsAppButton from '../contact/WhatsAppButton.astro';
import { site } from '../../config/site';

interface Props {
  pageName: string;
  /** Overrides the default message. */
  whatsappText?: string;
}
const { pageName, whatsappText } = Astro.props;
const message = whatsappText ?? `Hello ${site.name}, I have an enquiry about: ${pageName}`;
---

<div class="float-wa">
  <WhatsAppButton variant="icon" tone="dark" text={message} newTab />
</div>

<style>
  .float-wa { display: none; }
  @media (min-width: 769px) {
    .float-wa { position: fixed; right: 1.5rem; bottom: 1.5rem; z-index: 50; display: block; }
    .float-wa :global(.btn) {
      width: 3.25rem;
      min-height: 3.25rem;
      border: 0;
      border-radius: 50%;
      background: var(--color-navy);
      color: var(--color-white);
      box-shadow: 0 0 0 2px var(--color-white), 0 0 0 4px var(--color-cyan);
    }
    .float-wa :global(.btn:hover) { background: var(--color-blue); }
  }
</style>
