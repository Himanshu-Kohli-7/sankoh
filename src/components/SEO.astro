---
/**
 * Head tags + JSON-LD (SPEC §7). One Organization/LocalBusiness node with a stable @id,
 * referenced by every other schema on the site.
 * Only confirmed facts go in: office hours from site.ts; no geo or sameAs until they are provided.
 */
import { site } from '../config/site';
import { productGroups, type DivisionKey } from '../config/nav';

/**
 * Open Graph card for a path (public/og/, made by scripts/make-og.mjs): a category or product page
 * uses its division's card; repair, VFD and service pages use Repair & Service; the rest the default.
 */
function ogCard(pathname: string): { src: string; alt: string } {
  let division: DivisionKey | undefined;
  const category = pathname.match(/^\/products\/([a-z0-9-]+)\//)?.[1];
  if (category) division = productGroups.find((g) => g.links.some((l) => l.href === `/products/${category}/`))?.division;
  else if (/^\/(valve-repair|vfd-repair|services)\//.test(pathname)) division = 'repair';
  if (!division) return { src: '/og/default.jpg', alt: `${site.name}: industrial valves, instruments and repair` };
  return { src: `/og/${division}.jpg`, alt: `${site.name}: ${site.divisions[division].name}` };
}

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  /** Root-relative 1200×630 image overriding the division card. */
  ogImage?: string;
  /** Extra JSON-LD nodes for this page (Product, Service, FAQPage…). */
  schema?: Record<string, unknown>[];
}

const { title, description, breadcrumbs = [], noindex = false, ogImage, schema = [] } = Astro.props;

const abs = (path: string) => new URL(path, site.url).href;
const canonical = abs(Astro.url.pathname);
const card = ogCard(Astro.url.pathname);
const og = { src: abs(ogImage ?? card.src), alt: card.alt };
const orgId = `${site.url}/#organization`;

const organization = {
  '@type': ['Organization', 'LocalBusiness'],
  '@id': orgId,
  name: site.name,
  url: `${site.url}/`,
  logo: abs('/web-app-manifest-512x512.png'),
  image: abs('/web-app-manifest-512x512.png'),
  description: site.positioning,
  /** Primary number first; the sales line follows as a ContactPoint. */
  telephone: site.phone.e164,
  contactPoint: [
    { '@type': 'ContactPoint', telephone: site.salesPhone.e164, contactType: 'sales', areaServed: 'IN' },
  ],
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${site.address.line1}, ${site.address.line2}`,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.countryCode,
  },
  areaServed: { '@type': 'Country', name: 'India' },
  ...(site.pending.geo ? { geo: { '@type': 'GeoCoordinates', ...site.pending.geo } } : {}),
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: site.hours.days, opens: site.hours.opens, closes: site.hours.closes },
  ],
  ...(site.pending.sameAs.length ? { sameAs: site.pending.sameAs } : {}),
};

const graph: Record<string, unknown>[] = [organization];

/** No SearchAction: the site has no search. */
if (Astro.url.pathname === '/') {
  graph.push({
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: `${site.url}/`,
    name: site.name,
    inLanguage: site.locale,
    publisher: { '@id': orgId },
  });
}

if (breadcrumbs.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: [{ label: 'Home', href: '/' }, ...breadcrumbs].map((c, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: c.label,
      item: abs(c.href ?? Astro.url.pathname),
    })),
  });
}

graph.push(...schema);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
const { integrations } = site;
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content="en_IN" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={og.src} />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={og.alt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={og.src} />
<meta name="twitter:image:alt" content={og.alt} />

{integrations.searchConsoleVerification && (
  <meta name="google-site-verification" content={integrations.searchConsoleVerification} />
)}
{integrations.bingVerification && <meta name="msvalidate.01" content={integrations.bingVerification} />}

<script type="application/ld+json" is:inline set:html={jsonLd} />
