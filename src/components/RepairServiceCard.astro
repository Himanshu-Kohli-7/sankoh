---
/** Repair service tile (amber division): line icon, name, summary. */
import Icon from './Icon.astro';

interface Props {
  title: string;
  href: string;
  icon: string;
  summary?: string;
  headingLevel?: 'h2' | 'h3';
}
const { title, href, icon, summary, headingLevel: Tag = 'h3' } = Astro.props;
---

<article class="card repair" data-division="repair">
  <span class="icon"><Icon name={icon} size={28} /></span>
  <div>
    <Tag class="title"><a class="card-link" href={href}>{title}</a></Tag>
    {summary && <p class="summary">{summary}</p>}
  </div>
</article>

<style>
  .repair { flex-direction: row; gap: 1rem; padding: 1.25rem; }
  .icon { flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; border: 1px solid var(--color-line); border-radius: 2px; background: var(--color-paper); color: var(--color-navy); }
  .title { font-size: 1.125rem; line-height: 1.3; }
  .card:hover .title { color: var(--color-blue); }
  .summary { margin-top: 0.375rem; color: var(--color-slate); font-size: 0.9375rem; line-height: 1.5; }
</style>
